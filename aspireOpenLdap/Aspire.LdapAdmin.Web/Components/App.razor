<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Inline favicon: keeps the console clean (no favicon.ico 404) without adding a binary
       asset to the payload. *@
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='13' font-size='13'%3E%F0%9F%93%92%3C/text%3E%3C/svg%3E" />
    @* Theme boot: stamps data-theme on <html> before first paint so neither theme flashes.
       Explicit AppHost Light/Dark settings are authoritative; System follows the browser's
       color-scheme preference. Dark is a token-override layer only. *@
    <script>
        (function () {
            var configured = '@Settings.Theme';
            var preference = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
            function apply() {
                document.documentElement.dataset.theme = configured === 'Light' ? 'light'
                    : configured === 'Dark' ? 'dark'
                    : (preference && preference.matches ? 'dark' : 'light');
            }
            apply();
            if (configured === 'System' && preference) preference.addEventListener('change', apply);
        })();
    </script>
    <ResourcePreloader />
    @* The Industry design system: self-hosted fonts, the vendored token sheet, then the
       console styles that build on it. *@
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/industry-styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/console.css"]" />
    <link rel="stylesheet" href="@Assets["Aspire.LdapAdmin.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject]
    private LdapAdminSettings Settings { get; set; } = default!;
}
