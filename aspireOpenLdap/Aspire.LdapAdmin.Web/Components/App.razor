<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Inline favicon: keeps the console clean (no favicon.ico 404) without adding a binary
       asset to the payload. *@
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='13' font-size='13'%3E%F0%9F%93%92%3C/text%3E%3C/svg%3E" />
    @* Theme boot: stamps data-theme on <html> before first paint so neither theme flashes.
       A persisted choice wins; otherwise the AppHost default (LdapAdmin__Theme), with
       System resolving through prefers-color-scheme. Dark is a token-override layer only
       (docs/decisions.md § Product, 2026-08-10). *@
    <script>
        (function () {
            var mode = null;
            try { mode = localStorage.getItem('aspireldap.theme'); } catch (e) { }
            if (mode !== 'light' && mode !== 'dark') {
                var configured = '@Settings.Theme';
                mode = configured === 'Light' ? 'light'
                    : configured === 'Dark' ? 'dark'
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            }
            document.documentElement.dataset.theme = mode;
        })();
    </script>
    <ResourcePreloader />
    @* The Industry design system (docs/decisions.md § Product, 2026-08-10): self-hosted
       fonts, the vendored token sheet, then the console styles that build on it. *@
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/industry-styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/console.css"]" />
    <link rel="stylesheet" href="@Assets["Aspire.LdapAdmin.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject]
    private LdapAdminSettings Settings { get; set; } = default!;
}
