@*
    App shell: header, destination rail, body. There is no login gate by decision
    (docs/decisions.md § Scope): the app binds with the AppHost-provided credentials and
    opens straight onto the directory.

    Header content is plain text that inherits. FluentHeader fills with the accent colour
    and sets a matching foreground token; FluentLabel/FluentButton placed on it bring
    neutral-surface tokens onto the accent surface (measured 1.87:1 in dark theme —
    docs/findings.md § Fluent UI Blazor v4).
*@
@inherits LayoutComponentBase

<FluentDesignTheme @bind-Mode="_mode" StorageName="ldapadmin-theme" />

<FluentLayout>
    <FluentHeader>
        Aspire LdapAdmin
    </FluentHeader>

    <FluentStack Orientation="@Orientation.Horizontal" Width="100%">
        <FluentStack Orientation="@Orientation.Vertical" VerticalGap="12" Width="200px">
            @* Not collapsible: the toggle reads as an unlabelled destination, and a rail
               with three items has nothing worth reclaiming (old repo #51). *@
            <FluentNavMenu Width="200" Title="Destinations">
                <FluentNavLink Href="/" Match="@NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.Folder())">Browse</FluentNavLink>
                <FluentNavLink Href="/search"
                               Icon="@(new Icons.Regular.Size20.Search())">Search</FluentNavLink>
                <FluentNavLink Href="/schema"
                               Icon="@(new Icons.Regular.Size20.DocumentBulletList())">Schema</FluentNavLink>
            </FluentNavMenu>
            @* Theme control lives on the neutral rail, not the accent header (see above). *@
            <FluentSelect TOption="DesignThemeModes"
                          Items="@AllModes"
                          OptionText="@(m => m.ToString())"
                          @bind-SelectedOption="_mode"
                          Label="Theme"
                          Style="margin-inline: 12px;" />
        </FluentStack>

        <FluentBodyContent>
            @Body
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

<FluentToastProvider />

@* Kept from the template so an unhandled circuit error is still announced; hidden by the
   inline style until blazor.web.js flips display on error, so no stylesheet is needed. *@
<div id="blazor-error-ui" data-nosnippet style="display: none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
</div>

@code {
    private static readonly DesignThemeModes[] AllModes = Enum.GetValues<DesignThemeModes>();

    private DesignThemeModes _mode = DesignThemeModes.System;
}
