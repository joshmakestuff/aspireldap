@page "/Error"
@using System.Diagnostics

<PageTitle>Error — AspireLdap</PageTitle>

<div style="padding: var(--space-8);">
    <h3 style="margin: 0;">An error occurred while processing your request.</h3>

    @if (ShowRequestId)
    {
        <p style="font-size: 13px;">
            Request ID: <span class="mono">@RequestId</span>
        </p>
    }

    <p class="text-muted" style="font-size: 13px;">
        For local debugging, set <span class="mono">ASPNETCORE_ENVIRONMENT=Development</span>
        and restart the app to see detailed error information. Do not enable the Development
        environment for deployed applications — it can expose sensitive exception details.
    </p>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
