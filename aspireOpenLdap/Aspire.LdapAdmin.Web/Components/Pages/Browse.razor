@*
    The app shell and directory browser in one page, in the Industry design handoff's
    layout: top bar (brand + connection chip + refresh + theme), view tabs (Directory /
    Search / Schema), then the work grid — tree rail, drag-handle separator, contextual
    pane. The tree lives here and is never re-created on a view switch, so browse context
    survives searching and reading the schema. Search and Schema render as always-alive
    panels toggled by display, not @if — their state survives view switches too.

    Scroll model: the page NEVER scrolls. The .app grid is viewport-sized with definite
    rows; .rail and .pane are the two scroll regions (console.css).

    Tree behavior (design handoff § Tree, deliberate substitute for virtualization):
    children load on first expand via one-level searches with SizeLimit = CAP + 1; an
    expanded node renders at most PAGE children at a time behind a "show more" row; at CAP
    the row becomes "search this container", which lands on the Search view preset to that
    DN at one level. A directory can hold thousands of children per node — the cap keeps
    both the DOM and the LDAP query bounded.

    Stale responses never clobber the current selection: every selection takes a sequence
    token, and a response whose token is no longer current is discarded (see SelectAsync).
*@
@page "/"
@using System.DirectoryServices.Protocols
@using Aspire.LdapAdmin.Web.Components.Directory
@using LdifDotNet
@implements IAsyncDisposable
@inject LdapDirectoryService Directory
@inject LdapSchemaService SchemaService
@inject LdapAdminSettings Settings
@inject ConsoleConnectionInfo Connection
@inject NavigationManager Navigation
@inject ConsoleToastService Toasts
@inject ConsoleClipboard Clipboard
@inject IJSRuntime Js

<PageTitle>@ViewTitle — AspireLdap</PageTitle>

<div class="app">
    <div class="topbar">
        <div class="brand">AspireLdap<small>directory admin</small></div>
        <div class="conn mono"><i class="led"></i>@Connection.ServerLabel</div>
        <div class="conn mono">bind: @Connection.BindDn</div>
        <button class="btn btn-secondary btn-sm" @onclick="RefreshAsync">Refresh</button>
        <button class="btn btn-secondary btn-icon btn-sm" style="width: 26px; height: 26px;"
                title="Toggle light/dark theme" aria-label="Toggle light/dark theme"
                @onclick="ToggleThemeAsync">◐</button>
    </div>

    <div class="vtabs" role="tablist" aria-label="Console views">
        <button class="vt" role="tab" aria-selected="@Selected(AdminView.Browse)"
                @onclick="@(() => SwitchView(AdminView.Browse))">Directory</button>
        <button class="vt" role="tab" aria-selected="@Selected(AdminView.Search)"
                @onclick="@(() => SwitchView(AdminView.Search))">Search</button>
        <button class="vt" role="tab" aria-selected="@Selected(AdminView.Schema)"
                @onclick="@(() => SwitchView(AdminView.Schema))">Schema</button>
    </div>

    <div class="work">
        <div class="rail">
            <div class="railtop">
                <div class="railrow">
                    <div class="railhead">Directory information tree</div>
                    <button class="btn btn-secondary btn-sm" @onclick="OpenChildDialog"
                            disabled="@(_selectedDn is null)">New entry…</button>
                </div>
                <input class="input mono railfilter" placeholder="filter RDN…" spellcheck="false"
                       aria-label="Filter tree rows by RDN" @bind="_treeFilter" @bind:event="oninput" />
            </div>
            @if (_root is null)
            {
                <p class="text-muted" style="font-size: 13px; padding: var(--space-2);">Loading…</p>
            }
            else
            {
                @foreach (var row in BuildRows())
                {
                    <button class="trow @row.DepthClass @row.MoreClass" aria-current="@(row.Current ? "true" : null)"
                            @key="row.Key" @onclick="@(() => OnRowClickAsync(row))">
                        @if (row.HasTwisty)
                        {
                            <i class="tw tw-on" @onclick="@(() => ToggleAsync(row.Node!))"
                               @onclick:stopPropagation="true">@row.Twisty</i>
                        }
                        else
                        {
                            <i class="tw">@row.Twisty</i>
                        }
                        <span class="tlabel mono">@row.Label</span>
                        @if (row.Count.Length > 0)
                        {
                            <i class="tcount mono">@row.Count</i>
                        }
                    </button>
                }
            }
        </div>
        <button class="split" role="separator" aria-orientation="vertical"
                aria-label="Resize the directory tree" @ref="_splitter"></button>
        <div class="pane">
            <div style="@PanelDisplay(AdminView.Browse)">
                @if (_error is not null)
                {
                    <div class="bar err" role="alert">@_error</div>
                }

                @if (_loadingEntry)
                {
                    <p class="text-muted" style="font-size: 13px;">Loading…</p>
                }
                else if (_entry is not null)
                {
                    <div class="dh">
                        <div style="min-width: 0;">
                            <h3 style="margin: 0;">@EntryTitle(_entry)</h3>
                            <div class="dnline mono">
                                @_entry.Dn
                                <button class="btn btn-ghost btn-sm" title="Copy DN to clipboard"
                                        @onclick="@(() => CopyDnAsync(_entry.Dn))">Copy</button>
                            </div>
                        </div>
                        <div class="dhact">
                            <button class="btn btn-secondary btn-sm" @onclick="OpenAddAttributeDialog">Add attribute</button>
                            <button class="btn btn-secondary btn-sm" @onclick="OpenChildDialog">New child</button>
                            <button class="btn btn-secondary btn-sm" @onclick="OpenRenameDialog">Rename</button>
                            <button class="btn btn-secondary btn-sm" @onclick="OpenDeleteDialog">Delete</button>
                        </div>
                    </div>

                    <div class="strip" style="margin-top: var(--space-4);">
                        <div class="stat"><b class="mono">@_entry.Attributes.Count</b><span>attributes</span></div>
                        <div class="stat"><b class="mono">@_entry.Attributes.Sum(static a => a.Values.Count)</b><span>values</span></div>
                        <div class="stat"><b class="mono">@ObjectClassCount(_entry)</b><span>object classes</span></div>
                    </div>

                    <EntryView Entry="_entry" OnEdit="OpenEditAttributeDialog" />
                }
                else if (_error is null)
                {
                    <p class="text-muted" style="font-size: 13px;">Select an entry.</p>
                }
            </div>
            <div style="@PanelDisplay(AdminView.Search)">
                <SearchPanel @ref="_searchPanel" OnEntrySelected="OnSearchEntrySelected" />
            </div>
            @if (_schemaVisited)
            {
                <div style="@PanelDisplay(AdminView.Schema)">
                    <SchemaPanel />
                </div>
            }
        </div>
    </div>
</div>

@if (_attributeDialog is { } attributeDialog)
{
    <AttributeDialog Model="attributeDialog" Schema="_dialogSchema" OnClose="CloseDialogs" />
}
@if (_newEntry is { } newEntry)
{
    <NewEntryWizard Model="newEntry" Schema="_dialogSchema" OnClose="CloseDialogs" />
}
@if (_renameDialog is { } renameDialog)
{
    <RenameDialog Model="renameDialog" OnClose="CloseDialogs" />
}
@if (_deleteDialog is { } deleteDialog)
{
    <DeleteDialog Model="deleteDialog" OnClose="CloseDialogs" />
}

@* popover=manual: dialogs are top-layer natives now (#117), and the design rule is that
   write confirmations stay visible over an open dialog — the toast joins the top layer
   after the dialog, so it paints above. Known limit: a toast already showing when a
   dialog opens sits under it for its remaining ≤2.6 s. *@
@if (_toast is { Length: > 0 })
{
    <div class="toast mono" role="status" aria-live="polite" popover="manual" @ref="_toastElement">@_toast</div>
}

@code {
    /// <summary>Children an expanded node reveals per "show more" click (design handoff).</summary>
    internal const int Page = 12;

    /// <summary>
    /// The most children a node ever renders (design handoff): past it, the row hands off to
    /// the Search view. Child fetches use Cap + 1 so "more than Cap exist" is knowable.
    /// </summary>
    internal const int Cap = 48;

    private const int AutoExpandDepth = 2;

    private TreeNode? _root;
    private string _treeFilter = string.Empty;
    private string? _selectedDn;
    private LdapEntry? _entry;
    private string? _error;
    private bool _loadingEntry;

    private SearchPanel? _searchPanel;
    private ElementReference _splitter;
    private IJSObjectReference? _js;

    private AttributeDialogModel? _attributeDialog;
    private NewEntryModel? _newEntry;
    private RenameDialogModel? _renameDialog;
    private DeleteDialogModel? _deleteDialog;

    /// <summary>The subschema for the schema-aware dialogs; null degrades them to free text.</summary>
    private LdifDotNet.Schema.LdapSchema? _dialogSchema;

    private string? _toast;
    private ElementReference _toastElement;
    private CancellationTokenSource? _toastCts;

    /// <summary>
    /// The stale-response guard: each selection takes the next token, and every await in
    /// SelectAsync/RevealAsync re-checks it afterwards. A response that arrives after the
    /// user has moved on is discarded instead of clobbering the newer selection.
    /// </summary>
    private int _selectSeq;

    /// <summary>
    /// Deep link target ("/?dn=..."), used by search results and by the address bar itself.
    /// Arriving here selects the entry and reveals its tree row — navigating and showing
    /// the root instead would silently discard the entry the user clicked.
    /// </summary>
    [SupplyParameterFromQuery(Name = "dn")]
    public string? DeepLinkDn { get; set; }

    /// <summary>Which view the contextual pane shows ("search"/"schema"; anything else = browse).</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewParam { get; set; }

    internal enum AdminView { Browse, Search, Schema }

    private AdminView _view = AdminView.Browse;

    /// <summary>
    /// The schema panel renders only after its first visit (loading the whole subschema on
    /// app start would be waste), then stays alive behind a display toggle so the loaded
    /// schema and filter state survive later view switches.
    /// </summary>
    private bool _schemaVisited;

    private string ViewTitle => _view switch
    {
        AdminView.Search => "Search",
        AdminView.Schema => "Schema",
        _ => "Directory",
    };

    private string Selected(AdminView view) => _view == view ? "true" : "false";

    /// <summary>Hides an inactive panel without destroying it; the wrapper div is owned markup.</summary>
    private string? PanelDisplay(AdminView view) => _view == view ? null : "display: none;";

    // ---- Tree ---------------------------------------------------------------------------

    /// <summary>
    /// One loaded tree node. Children is null until the node's first expand; after a load it
    /// holds at most Cap entries and Capped says whether the directory had more.
    /// </summary>
    private sealed class TreeNode
    {
        public required string Dn { get; init; }
        public required string Rdn { get; init; }
        public bool HasChildren { get; set; }
        public bool Open { get; set; }
        public int Shown { get; set; } = Page;
        public List<TreeNode>? Children { get; set; }
        public bool Capped { get; set; }
    }

    /// <summary>One rendered rail row: a node, a "show more" row, or the cap's search handoff.</summary>
    private readonly record struct Row(
        string Key, TreeNode? Node, string Label, string Twisty, bool HasTwisty,
        string Count, string DepthClass, string MoreClass, bool Current, bool IsMore, bool IsCap);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The root row shows its first RDN like every other row (design reference:
            // "dc=aspire", not the whole base DN); the full DN stays in the topbar's model.
            var root = new TreeNode { Dn = Directory.BaseDn, Rdn = FirstRdn(Directory.BaseDn), HasChildren = true };
            await ExpandAsync(root, AutoExpandDepth);
            _root = root;
        }
        catch (DirectoryException ex)
        {
            _error = Describe(ex);
        }

        // For the schema-aware dialogs (#103/#105). Process-lifetime cached in the service;
        // an unreadable subschema comes back as data (Available = false), never a throw.
        var schema = await SchemaService.GetSchemaAsync();
        _dialogSchema = schema.Available ? schema.Schema : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _js = await Js.InvokeAsync<IJSObjectReference>("import", "./js/console.js");
            await _js.InvokeVoidAsync("initRail", _splitter);
        }
        // Every render: the toast element appears and disappears with _toast, and a manual
        // popover must be re-shown each time it (re)enters the DOM. Idempotent in JS.
        if (_toast is { Length: > 0 } && _js is not null)
        {
            await _js.InvokeVoidAsync("showToastPopover", _toastElement);
        }
    }

    /// <summary>
    /// Runs on first render and on every later query-string change, so clicking a second
    /// search result while already on this page still moves the selection.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        _view = ViewParam?.ToLowerInvariant() switch
        {
            "search" => AdminView.Search,
            "schema" => AdminView.Schema,
            _ => AdminView.Browse,
        };
        _schemaVisited |= _view == AdminView.Schema;

        if (DeepLinkDn is { Length: > 0 } dn && !string.Equals(dn, _selectedDn, StringComparison.Ordinal))
        {
            await SelectAsync(dn, reveal: true);
        }
    }

    /// <summary>
    /// Loads one node's children (SizeLimit = Cap + 1, so "more than Cap" is knowable) and,
    /// while <paramref name="depth"/> allows, theirs too. The node is left expanded.
    /// </summary>
    private async Task ExpandAsync(TreeNode node, int depth)
    {
        if (depth <= 0)
        {
            return;
        }

        if (node.Children is null)
        {
            var children = await Directory.GetChildrenAsync(node.Dn, limit: Cap + 1);
            // Display order only — the AppHost-set default (#98); truncation semantics are
            // the server's and are not affected by how the returned children are ordered.
            var ordered = Settings.DefaultSortOrder == LdapAdminSortOrder.Rdn
                ? children.Children.OrderBy(static c => c.Rdn, StringComparer.OrdinalIgnoreCase)
                : (IEnumerable<LdapChildEntry>)children.Children;
            var loaded = ordered
                .Select(static c => new TreeNode { Dn = c.Dn, Rdn = c.Rdn, HasChildren = c.HasChildren })
                .ToList();
            node.Capped = children.Truncated || loaded.Count > Cap;
            if (loaded.Count > Cap)
            {
                loaded.RemoveRange(Cap, loaded.Count - Cap);
            }
            node.Children = loaded;
        }

        node.Open = true;

        foreach (var child in node.Children.Where(static c => c.HasChildren))
        {
            await ExpandAsync(child, depth - 1);
        }
    }

    private async Task ToggleAsync(TreeNode node)
    {
        if (node.Open)
        {
            node.Open = false;
            return;
        }

        try
        {
            await ExpandAsync(node, depth: 1);
        }
        catch (DirectoryException ex)
        {
            _error = Describe(ex);
        }
    }

    /// <summary>
    /// Flattens the loaded tree into rail rows: paging rows past PAGE, the search handoff at
    /// CAP, and — while the RDN filter is non-empty — only matches and their ancestors, with
    /// ancestors force-open so clearing the filter restores the prior open state.
    /// </summary>
    private List<Row> BuildRows()
    {
        var rows = new List<Row>();
        if (_root is not null)
        {
            Walk(_root, 0, _treeFilter.Trim(), rows);
        }
        return rows;
    }

    private void Walk(TreeNode node, int depth, string query, List<Row> rows)
    {
        var filtering = query.Length > 0;
        var visibleChildren = node.Children;
        if (filtering && visibleChildren is not null)
        {
            visibleChildren = [.. visibleChildren.Where(c => FilterVisible(c, query))];
        }

        var isParent = node.HasChildren;
        var isOpen = filtering ? visibleChildren is { Count: > 0 } : node.Open;
        var twisty = isParent ? (isOpen ? "▾" : "▸") : "·";
        var count = isParent && !isOpen && node.Children is { } loaded
            ? loaded.Count + (node.Capped ? "+" : string.Empty)
            : string.Empty;

        rows.Add(new Row(
            Key: node.Dn, Node: node, Label: node.Rdn, Twisty: twisty,
            HasTwisty: isParent, Count: count, DepthClass: Depth(depth), MoreClass: string.Empty,
            Current: string.Equals(node.Dn, _selectedDn, StringComparison.OrdinalIgnoreCase),
            IsMore: false, IsCap: false));

        if (!isOpen || visibleChildren is null)
        {
            return;
        }

        var shown = filtering ? visibleChildren.Count : Math.Min(node.Shown, visibleChildren.Count);
        foreach (var child in visibleChildren.Take(shown))
        {
            Walk(child, depth + 1, query, rows);
        }

        if (filtering)
        {
            return;
        }

        var hidden = visibleChildren.Count - shown;
        if (hidden > 0)
        {
            rows.Add(new Row(
                Key: node.Dn + "::more", Node: node,
                Label: $"{hidden} more of {visibleChildren.Count} — show {Math.Min(hidden, Page)}",
                Twisty: "⋯", HasTwisty: false, Count: string.Empty,
                DepthClass: Depth(depth + 1), MoreClass: "more", Current: false,
                IsMore: true, IsCap: false));
        }
        else if (node.Capped)
        {
            // The directory has more children than Cap; the row hands off to Search scoped
            // to this container, which pages properly (design handoff § Tree behavior).
            rows.Add(new Row(
                Key: node.Dn + "::cap", Node: node,
                Label: "more entries not shown — search this container",
                Twisty: "⌕", HasTwisty: false, Count: string.Empty,
                DepthClass: Depth(depth + 1), MoreClass: "more cap", Current: false,
                IsMore: false, IsCap: true));
        }
    }

    /// <summary>A node is visible under the filter when its RDN matches or a loaded descendant's does.</summary>
    private static bool FilterVisible(TreeNode node, string query) =>
        node.Rdn.Contains(query, StringComparison.OrdinalIgnoreCase)
        || (node.Children?.Any(c => FilterVisible(c, query)) ?? false);

    private static string Depth(int depth) => "dp" + Math.Min(depth, 6);

    private async Task OnRowClickAsync(Row row)
    {
        if (row.IsMore)
        {
            row.Node!.Shown += Page;
            return;
        }

        if (row.IsCap)
        {
            // Land on real results: base = this container, one level, match-all filter.
            Navigation.NavigateTo(Url(AdminView.Search, _selectedDn), forceLoad: false);
            if (_searchPanel is not null)
            {
                await _searchPanel.PresetAndRunAsync(row.Node!.Dn, SearchScope.OneLevel, "(objectClass=*)");
            }
            return;
        }

        var node = row.Node!;
        if (node.HasChildren && !node.Open)
        {
            await ToggleAsync(node);
        }
        await SelectAsync(node.Dn, reveal: false);
    }

    // ---- Selection ----------------------------------------------------------------------

    /// <summary>The URL is the view state: view + selected dn, both restorable from a deep link.</summary>
    private static string Url(AdminView view, string? dn)
    {
        var query = new List<string>(2);
        if (view is AdminView.Search or AdminView.Schema)
        {
            query.Add($"view={view.ToString().ToLowerInvariant()}");
        }
        if (dn is { Length: > 0 })
        {
            query.Add($"dn={Uri.EscapeDataString(dn)}");
        }
        return query.Count == 0 ? "/" : $"/?{string.Join('&', query)}";
    }

    private void SwitchView(AdminView view)
    {
        if (view != _view)
        {
            Navigation.NavigateTo(Url(view, _selectedDn), forceLoad: false);
        }
    }

    /// <summary>
    /// A clicked search result becomes the selection: the URL switches to the browse view
    /// naming the entry, and OnParametersSetAsync selects + reveals it in the tree.
    /// </summary>
    private void OnSearchEntrySelected(string dn) =>
        Navigation.NavigateTo(Url(AdminView.Browse, dn), forceLoad: false);

    private async Task SelectAsync(string dn, bool reveal)
    {
        // Keep the address bar naming the entry on screen; replace, not push — selecting is
        // view state, and pushing would make Back step through every entry visited. The view
        // param is dropped deliberately: selecting an entry is a browse action, so a tree
        // click while the search or schema panel is open switches the pane to the editor.
        if (!string.Equals(DeepLinkDn, dn, StringComparison.Ordinal) || _view != AdminView.Browse)
        {
            Navigation.NavigateTo(Url(AdminView.Browse, dn), forceLoad: false, replace: true);
        }

        var token = ++_selectSeq;
        _selectedDn = dn;
        _entry = null;
        _error = null;
        _loadingEntry = true;
        LdapEntry? entry = null;
        string? error = null;
        try
        {
            entry = await Directory.GetEntryAsync(dn);
        }
        catch (DirectoryException ex)
        {
            error = Describe(ex);
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }

        if (token != _selectSeq)
        {
            // A newer selection owns the pane now; this response is stale and is dropped.
            return;
        }

        _loadingEntry = false;
        _entry = entry;
        _error = error ?? (entry is null ? $"No entry exists at '{dn}' (or this bind cannot see it)." : null);

        if (reveal && entry is not null)
        {
            await RevealAsync(dn, token);
        }
    }

    /// <summary>
    /// Expands the tree along the ancestor chain of <paramref name="dn"/> so a deep link
    /// lands on a visible row rather than a collapsed root. Paged-out rows are paged in;
    /// a row past the cap stays unrevealed — the entry pane already shows the entry.
    /// </summary>
    private async Task RevealAsync(string dn, int token)
    {
        if (_root is not { } root)
        {
            return;
        }

        IReadOnlyList<RelativeDistinguishedName> target;
        IReadOnlyList<RelativeDistinguishedName> baseRdns;
        try
        {
            target = Dn.Parse(dn);
            baseRdns = Dn.Parse(Directory.BaseDn);
        }
        catch (ArgumentException)
        {
            return;
        }

        if (target.Count < baseRdns.Count
            || !string.Equals(Norm(target.Skip(target.Count - baseRdns.Count)), Norm(baseRdns), StringComparison.OrdinalIgnoreCase))
        {
            return; // Outside the tree this page shows.
        }

        var current = root;
        for (var take = baseRdns.Count + 1; take <= target.Count; take++)
        {
            var ancestor = Norm(target.Skip(target.Count - take));
            if (current.Children is null)
            {
                try
                {
                    await ExpandAsync(current, depth: 1);
                }
                catch (DirectoryException)
                {
                    return; // The entry pane already shows the entry; reveal is best-effort.
                }
                if (token != _selectSeq)
                {
                    return;
                }
            }

            current.Open = true;
            var index = current.Children!.FindIndex(child =>
                NormOrNull(child.Dn) is { } norm && string.Equals(norm, ancestor, StringComparison.OrdinalIgnoreCase));
            if (index < 0)
            {
                return; // Capped out of the child list; the entry pane still shows it.
            }

            // Page the ancestor in if the PAGE window has it hidden.
            if (index >= current.Shown)
            {
                current.Shown = ((index / Page) + 1) * Page;
            }

            current = current.Children[index];
        }
    }

    private static string Norm(IEnumerable<RelativeDistinguishedName> rdns) =>
        string.Join(',', rdns.Select(static rdn => rdn.ToString()));

    private static string? NormOrNull(string dn)
    {
        try
        {
            return Norm(Dn.Parse(dn));
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    // ---- Top bar ------------------------------------------------------------------------

    /// <summary>Reloads the tree from the root and re-fetches the selected entry.</summary>
    private async Task RefreshAsync()
    {
        _root = null;
        _error = null;
        StateHasChanged();
        await OnInitializedAsync();
        if (_selectedDn is { } dn)
        {
            await SelectAsync(dn, reveal: true);
        }
        ShowToast("directory reloaded");
    }

    private async Task ToggleThemeAsync()
    {
        if (_js is not null)
        {
            await _js.InvokeVoidAsync("toggleTheme");
        }
    }

    private async Task CopyDnAsync(string dn) =>
        ShowToast(await Clipboard.CopyAsync(dn) ? "DN copied" : "copy failed — clipboard unavailable");

    // ---- Toast --------------------------------------------------------------------------

    protected override void OnInitialized() => Toasts.Shown += OnToast;

    private void OnToast(object? sender, ToastEventArgs args)
    {
        _ = InvokeAsync(() => ShowToast(args.Message));
    }

    /// <summary>One toast at a time, bottom center, auto-cleared (design handoff § Toast).</summary>
    private void ShowToast(string message)
    {
        _toastCts?.Cancel();
        var cts = new CancellationTokenSource();
        _toastCts = cts;
        _toast = message;
        StateHasChanged();
        _ = Task.Delay(TimeSpan.FromSeconds(2.6), cts.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _ = InvokeAsync(() =>
                {
                    _toast = null;
                    StateHasChanged();
                });
            }
        }, TaskScheduler.Default);
    }

    // ---- Entry editing ------------------------------------------------------------------
    //
    // The four dialogs render inline on the owned ConsoleDialog frame (one at a time). Each
    // model carries its save delegate; the dialog shows a returned error inline and closes
    // only on null (success). Closing raises OnClose here, which re-renders this page — so
    // the editor always shows post-save state.

    private void CloseDialogs()
    {
        _attributeDialog = null;
        _newEntry = null;
        _renameDialog = null;
        _deleteDialog = null;
    }

    /// <summary>
    /// One dialog at a time is a shell invariant, not a UI accident: the toolbar stays
    /// live while a dialog is open, and a second open would orphan the first mid-save (#117).
    /// </summary>
    private bool DialogOpen =>
        _attributeDialog is not null || _newEntry is not null
        || _renameDialog is not null || _deleteDialog is not null;

    private void OpenEditAttributeDialog(LdapAttributeValues attribute)
    {
        if (DialogOpen || _entry is not { } entry)
        {
            return;
        }
        _attributeDialog = new AttributeDialogModel
        {
            IsNew = false,
            Name = attribute.Name,
            IsBinary = attribute.IsBinary,
            ValuesText = string.Join('\n', attribute.Values),
            Entry = entry,
            SaveAsync = SaveAttributeAsync,
        };
    }

    private void OpenAddAttributeDialog()
    {
        if (DialogOpen || _entry is not { } entry)
        {
            return;
        }
        _attributeDialog = new AttributeDialogModel { IsNew = true, Entry = entry, SaveAsync = SaveAttributeAsync };
    }

    private void OpenChildDialog()
    {
        if (!DialogOpen && _selectedDn is { } dn)
        {
            _newEntry = new NewEntryModel { ParentDn = dn, SaveAsync = SaveNewEntryAsync };
        }
    }

    private void OpenRenameDialog()
    {
        if (!DialogOpen && _selectedDn is { } dn)
        {
            _renameDialog = new RenameDialogModel { Dn = dn, SaveAsync = SaveRenameAsync };
        }
    }

    private void OpenDeleteDialog()
    {
        if (!DialogOpen && _selectedDn is { } dn)
        {
            _deleteDialog = new DeleteDialogModel { Dn = dn, SaveAsync = ConfirmDeleteAsync };
        }
    }

    /// <summary>Save delegates: null = success (the dialog closes); a string = shown inline.</summary>
    private async Task<string?> SaveAttributeAsync(AttributeDialogModel dialog)
    {
        if (_selectedDn is not { } dn)
        {
            return "No entry is selected.";
        }

        var values = Lines(dialog.ValuesText);
        if (dialog.IsNew && values.Count == 0)
        {
            return "Enter at least one value.";
        }

        var change = new LdapAttributeChange(
            dialog.IsNew ? DirectoryAttributeOperation.Add : DirectoryAttributeOperation.Replace,
            dialog.Name,
            values,
            IsBase64: dialog.IsBinary);
        var result = await GuardedAsync(() => Directory.ModifyEntryAsync(dn, [change]));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        ShowToast($"modify {dn} — {dialog.Name} saved");
        await SelectAsync(dn, reveal: false);
        return null;
    }

    /// <summary>
    /// The wizard composes the entry (chained classes, escaped RDN — a pasted full DN is
    /// structurally impossible there); this applies it and lands on the new entry.
    /// </summary>
    private async Task<string?> SaveNewEntryAsync(LdapNewEntry entry)
    {
        var result = await GuardedAsync(() => Directory.AddEntryAsync(entry));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        ShowToast($"ldapadd — {entry.Dn} created");
        await ReloadChildrenAsync(ParentOf(entry.Dn) ?? Directory.BaseDn);
        await SelectAsync(entry.Dn, reveal: true);
        return null;
    }

    private async Task<string?> SaveRenameAsync(RenameDialogModel dialog)
    {
        var newParent = dialog.NewParentDn.Length > 0 ? dialog.NewParentDn : null;
        LdapRenameResult rename;
        try
        {
            rename = await Directory.RenameEntryAsync(dialog.Dn, dialog.NewRdn, newParent, dialog.DeleteOldRdn);
        }
        catch (DirectoryException ex)
        {
            rename = new LdapRenameResult(new LdapOperationResult(LdapOperationStatus.Failed, null, Describe(ex)), null);
        }

        if (!rename.Outcome.Succeeded || rename.NewDn is null)
        {
            return Describe(rename.Outcome);
        }

        ShowToast($"modrdn — renamed to {rename.NewDn}");
        await ReloadChildrenAsync(ParentOf(dialog.Dn) ?? Directory.BaseDn);
        if (newParent is not null)
        {
            await ReloadChildrenAsync(newParent);
        }
        await SelectAsync(rename.NewDn, reveal: true);
        return null;
    }

    private async Task<string?> ConfirmDeleteAsync(DeleteDialogModel dialog)
    {
        var result = await GuardedAsync(() => Directory.DeleteEntryAsync(dialog.Dn, dialog.Subtree));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        ShowToast(dialog.Subtree
            ? $"ldapdelete -r — {dialog.Dn} and its subtree deleted"
            : $"ldapdelete — {dialog.Dn} deleted");
        var parent = ParentOf(dialog.Dn) ?? Directory.BaseDn;
        await ReloadChildrenAsync(parent);
        await SelectAsync(parent, reveal: true);
        return null;
    }

    /// <summary>Transport failures surface as an operation outcome, not a crash.</summary>
    private static async Task<LdapOperationResult> GuardedAsync(Func<Task<LdapOperationResult>> operation)
    {
        try
        {
            return await operation();
        }
        catch (DirectoryException ex)
        {
            return new LdapOperationResult(LdapOperationStatus.Failed, null, Describe(ex));
        }
    }

    /// <summary>Re-fetches one node's children after a write changed them.</summary>
    private async Task ReloadChildrenAsync(string parentDn)
    {
        if (NormOrNull(parentDn) is not { } norm || FindNode(norm) is not { } node)
        {
            return;
        }

        if (node.Children is not null)
        {
            node.Children = null;
            if (node.Open)
            {
                try
                {
                    await ExpandAsync(node, depth: 1);
                }
                catch (DirectoryException ex)
                {
                    _error = Describe(ex);
                }
            }
        }
    }

    private TreeNode? FindNode(string normDn)
    {
        if (_root is null)
        {
            return null;
        }

        var pending = new Stack<TreeNode>([_root]);
        while (pending.Count > 0)
        {
            var node = pending.Pop();
            if (NormOrNull(node.Dn) is { } norm && string.Equals(norm, normDn, StringComparison.OrdinalIgnoreCase))
            {
                return node;
            }
            foreach (var child in node.Children ?? [])
            {
                pending.Push(child);
            }
        }
        return null;
    }

    private static string? ParentOf(string dn)
    {
        try
        {
            var rdns = Dn.Parse(dn);
            return rdns.Count <= 1 ? null : Norm(rdns.Skip(1));
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    private static IReadOnlyList<string> Lines(string text) =>
        [.. text.Split('\n').Select(static line => line.TrimEnd('\r')).Where(static line => line.Length > 0)];

    private static string FirstRdn(string dn)
    {
        try
        {
            return Dn.Parse(dn)[0].ToString();
        }
        catch (ArgumentException)
        {
            return dn;
        }
    }

    /// <summary>
    /// The entry header's human title (design reference: "Alice Chen", not "alice.chen"):
    /// the display name when the entry carries one, the RDN's value part otherwise. The
    /// attribute order matches SearchPanel's name column (cn before displayName) so both
    /// surfaces agree on an entry's name. Binary values are skipped — base64 is not a title.
    /// </summary>
    internal static string EntryTitle(LdapEntry entry)
    {
        foreach (var name in (string[])["cn", "displayName", "ou", "o"])
        {
            var attribute = entry.Attributes.FirstOrDefault(
                a => a.Name.Equals(name, StringComparison.OrdinalIgnoreCase) && !a.IsBinary);
            if (attribute?.Values.FirstOrDefault(static v => v.Length > 0) is { } value)
            {
                return value;
            }
        }

        try
        {
            var rdns = Dn.Parse(entry.Dn);
            return rdns.Count == 0
                ? entry.Dn
                : string.Join("+", rdns[0].Attributes.Select(static a => a.Value));
        }
        catch (ArgumentException)
        {
            return entry.Dn;
        }
    }

    private static int ObjectClassCount(LdapEntry entry) =>
        entry.Attributes.FirstOrDefault(static a =>
            a.Name.Equals("objectClass", StringComparison.OrdinalIgnoreCase))?.Values.Count ?? 0;

    /// <summary>The outcome classes a UI renders differently, in words.</summary>
    internal static string Describe(LdapOperationResult result)
    {
        var label = result.Status switch
        {
            LdapOperationStatus.NotFound => "The entry (or a parent it needs) does not exist",
            LdapOperationStatus.AlreadyExists => "An entry with that DN already exists",
            LdapOperationStatus.AccessDenied => "Access denied — the server's ACL refused this bind",
            LdapOperationStatus.NotAllowedOnNonLeaf => "The entry has children, so it cannot be deleted or moved",
            LdapOperationStatus.SchemaViolation => "The change contradicts the server's schema",
            LdapOperationStatus.ConstraintViolation => "The change violates a server constraint",
            LdapOperationStatus.InvalidRequest => "The request is not valid",
            LdapOperationStatus.Refused => "The server refused the request",
            LdapOperationStatus.Failed => $"The server reported {result.ResultCode?.ToString() ?? "an unmodelled error"}",
            _ => result.Status.ToString(),
        };
        return result.Message is { Length: > 0 } message ? $"{label}: {message}" : $"{label}.";
    }

    private static string Describe(DirectoryException ex) =>
        $"The directory could not be reached ({ex.GetType().Name}): {ex.Message}";

    public async ValueTask DisposeAsync()
    {
        Toasts.Shown -= OnToast;
        _toastCts?.Cancel();
        if (_js is not null)
        {
            try
            {
                await _js.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone; nothing to dispose against.
            }
        }
    }
}
