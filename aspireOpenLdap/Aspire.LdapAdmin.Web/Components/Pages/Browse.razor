@*
    The app shell and directory browser in one page (layout spec aspireldap#102): header
    with brand + view switch, a persistent tree pane, and a contextual pane (entry editor /
    search / schema) separated by a draggable FluentMultiSplitter. The tree lives here and
    is never re-created on a view switch, so browse context survives searching and reading
    the schema. Search and Schema render as always-alive panels toggled by display, not
    @if — their state (results, loaded schema) survives view switches too.

    Scroll model: the page NEVER scrolls. The shell grid we own is viewport-sized
    (100dvh, definite rows — the fluent-ui trap list forbids indefinite-height flex +
    height:100% loops), and each pane wraps its content in its own overflow:auto region.
    The grid container and scroll wrappers are owned markup, so their CSS is legitimate.

    Children are fetched on first expand, never up front: a directory holds far more entries
    than a page should pull, and ITreeViewItem.OnExpandedAsync keeps the lazy load. Two
    levels open during initialisation — a single collapsed root line shows nothing.

    Stale responses never clobber the current selection: every selection takes a sequence
    token, and a response whose token is no longer current is discarded (see SelectAsync).
*@
@page "/"
@using System.DirectoryServices.Protocols
@using Aspire.LdapAdmin.Web.Components.Directory
@using LdifDotNet
@inject LdapDirectoryService Directory
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IDialogService DialogService

<PageTitle>@ViewTitle — Aspire LdapAdmin</PageTitle>

<div style="height: 100dvh; display: grid; grid-template-rows: auto minmax(0, 1fr); overflow: hidden;">
    <FluentHeader>
        Aspire LdapAdmin
        <FluentSpacer />
        @* Plain header text inherits the accent surface's own foreground token; the switch
           buttons paint their own fills, so no neutral-on-accent contrast trap
           (docs/findings.md § Fluent). Active view = Neutral fill (stands out on accent);
           inactive = Accent fill (blends into the header, on-accent foreground token). *@
        <FluentStack Orientation="@Orientation.Horizontal" HorizontalGap="8" Width="auto"
                     VerticalAlignment="@VerticalAlignment.Center">
            <FluentButton Appearance="@SwitchAppearance(AdminView.Browse)" aria-pressed="@AriaPressed(AdminView.Browse)"
                          IconStart="@(new Icons.Regular.Size16.Folder())"
                          OnClick="@(() => SwitchView(AdminView.Browse))">Browse</FluentButton>
            <FluentButton Appearance="@SwitchAppearance(AdminView.Search)" aria-pressed="@AriaPressed(AdminView.Search)"
                          IconStart="@(new Icons.Regular.Size16.Search())"
                          OnClick="@(() => SwitchView(AdminView.Search))">Search</FluentButton>
            <FluentButton Appearance="@SwitchAppearance(AdminView.Schema)" aria-pressed="@AriaPressed(AdminView.Schema)"
                          IconStart="@(new Icons.Regular.Size16.DocumentBulletList())"
                          OnClick="@(() => SwitchView(AdminView.Schema))">Schema</FluentButton>
        </FluentStack>
    </FluentHeader>

    <FluentMultiSplitter Height="100%" Width="100%" BarSize="6">
        <FluentMultiSplitterPane Size="340px" Min="220px" Max="75%">
            <div style="height: 100%; overflow: auto; padding: 8px;">
                @if (_roots is null)
                {
                    <FluentProgressRing />
                }
                else
                {
                    @* No ItemTemplate, deliberately: the FAST tree-view's click handler only selects
                       when the click's event.target IS the fluent-tree-item, so any template element
                       (a span for a tooltip, say) swallows selection clicks — measured on 4.14.4.
                       The default rendering keeps the item text as a text node, which clicks
                       attribute to the tree item itself. *@
                    <FluentTreeView Items="@_roots" LazyLoadItems="true" @bind-SelectedItem="_selectedItem"
                                    @bind-SelectedItem:after="OnSelectionChangedAsync" />
                }
            </div>
        </FluentMultiSplitterPane>
        <FluentMultiSplitterPane Min="320px">
            <div style="height: 100%; overflow: auto; padding: 12px 16px;">
                <div style="@PanelDisplay(AdminView.Browse)">
                    <FluentStack Orientation="@Orientation.Vertical" VerticalGap="12">
                        @if (_error is not null)
                        {
                            <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_error</FluentMessageBar>
                        }

                        @if (_loadingEntry)
                        {
                            <FluentProgressRing />
                        }
                        else if (_entry is not null)
                        {
                            <FluentStack Orientation="@Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                                <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                              OnClick="OpenAddAttributeDialog">Add attribute</FluentButton>
                                <FluentButton IconStart="@(new Icons.Regular.Size16.FolderAdd())"
                                              OnClick="OpenChildDialog">New child entry</FluentButton>
                                <FluentButton IconStart="@(new Icons.Regular.Size16.Rename())"
                                              OnClick="OpenRenameDialog">Rename</FluentButton>
                                <FluentButton IconStart="@(new Icons.Regular.Size16.Delete())"
                                              OnClick="OpenDeleteDialog">Delete</FluentButton>
                            </FluentStack>

                            <EntryView Entry="_entry" OnEdit="OpenEditAttributeDialog" />
                        }
                        else if (_error is null)
                        {
                            <FluentLabel Typo="@Typography.Body">Select an entry.</FluentLabel>
                        }
                    </FluentStack>
                </div>
                <div style="@PanelDisplay(AdminView.Search)">
                    <SearchPanel OnEntrySelected="OnSearchEntrySelected" />
                </div>
                @if (_schemaVisited)
                {
                    <div style="@PanelDisplay(AdminView.Schema)">
                        <SchemaPanel />
                    </div>
                }
            </div>
        </FluentMultiSplitterPane>
    </FluentMultiSplitter>
</div>

@code {
    private const int AutoExpandDepth = 2;

    /// <summary>Marks the placeholder row that stands in for children past the limit.</summary>
    private const string TruncatedIdPrefix = "truncated:";

    private List<ITreeViewItem>? _roots;
    private ITreeViewItem? _selectedItem;
    private string? _selectedDn;
    private LdapEntry? _entry;
    private string? _error;
    private bool _loadingEntry;

    /// <summary>
    /// The stale-response guard: each selection takes the next token, and every await in
    /// SelectAsync/RevealAsync re-checks it afterwards. A response that arrives after the
    /// user has moved on is discarded instead of clobbering the newer selection.
    /// </summary>
    private int _selectSeq;

    /// <summary>
    /// Deep link target ("/?dn=..."), used by search results and by the address bar itself.
    /// Arriving here selects the entry and reveals its tree row — navigating and showing
    /// the root instead would silently discard the entry the user clicked.
    /// </summary>
    [SupplyParameterFromQuery(Name = "dn")]
    public string? DeepLinkDn { get; set; }

    /// <summary>Which view the contextual pane shows ("search"/"schema"; anything else = browse).</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewParam { get; set; }

    internal enum AdminView { Browse, Search, Schema }

    private AdminView _view = AdminView.Browse;

    /// <summary>
    /// The schema panel renders only after its first visit (loading the whole subschema on
    /// app start would be waste), then stays alive behind a display toggle so the loaded
    /// schema and filter state survive later view switches.
    /// </summary>
    private bool _schemaVisited;

    private string ViewTitle => _view switch
    {
        AdminView.Search => "Search",
        AdminView.Schema => "Schema",
        _ => "Browse",
    };

    private Appearance SwitchAppearance(AdminView view) =>
        _view == view ? Appearance.Neutral : Appearance.Accent;

    private string AriaPressed(AdminView view) => _view == view ? "true" : "false";

    /// <summary>Hides an inactive panel without destroying it; the wrapper div is owned markup.</summary>
    private string? PanelDisplay(AdminView view) => _view == view ? null : "display: none;";

    /// <summary>The URL is the view state: view + selected dn, both restorable from a deep link.</summary>
    private static string Url(AdminView view, string? dn)
    {
        var query = new List<string>(2);
        if (view is AdminView.Search or AdminView.Schema)
        {
            query.Add($"view={view.ToString().ToLowerInvariant()}");
        }
        if (dn is { Length: > 0 })
        {
            query.Add($"dn={Uri.EscapeDataString(dn)}");
        }
        return query.Count == 0 ? "/" : $"/?{string.Join('&', query)}";
    }

    private void SwitchView(AdminView view)
    {
        if (view != _view)
        {
            Navigation.NavigateTo(Url(view, _selectedDn), forceLoad: false);
        }
    }

    /// <summary>
    /// A clicked search result becomes the selection: the URL switches to the browse view
    /// naming the entry, and OnParametersSetAsync selects + reveals it in the tree.
    /// </summary>
    private void OnSearchEntrySelected(string dn) =>
        Navigation.NavigateTo(Url(AdminView.Browse, dn), forceLoad: false);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var root = Node(Directory.BaseDn, Directory.BaseDn, hasChildren: true);
            await ExpandAsync(root, AutoExpandDepth);
            _roots = [root];
        }
        catch (DirectoryException ex)
        {
            _error = Describe(ex);
        }
    }

    /// <summary>
    /// Runs on first render and on every later query-string change, so clicking a second
    /// search result while already on this page still moves the selection.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        _view = ViewParam?.ToLowerInvariant() switch
        {
            "search" => AdminView.Search,
            "schema" => AdminView.Schema,
            _ => AdminView.Browse,
        };
        _schemaVisited |= _view == AdminView.Schema;

        if (DeepLinkDn is { Length: > 0 } dn && !string.Equals(dn, _selectedDn, StringComparison.Ordinal))
        {
            await SelectAsync(dn, reveal: true);
        }
    }

    private TreeViewItem Node(string dn, string rdn, bool hasChildren) => new()
    {
        Id = dn,
        Text = rdn,
        // A non-null child collection marks a node expandable before anything is loaded;
        // leaves get null, so they render without an expander.
        Items = hasChildren ? [] : null,
        OnExpandedAsync = hasChildren ? LoadOnExpandAsync : null,
    };

    /// <summary>
    /// Loads one node's children and, while <paramref name="depth"/> allows, theirs too.
    /// Truncation gets a visible, disabled marker row — a tree that just stops looks
    /// complete, which is the one wrong impression a directory browser must not give.
    /// </summary>
    private async Task ExpandAsync(TreeViewItem node, int depth)
    {
        if (depth <= 0 || node.Items is null || node.Id is null)
        {
            return;
        }

        var children = await Directory.GetChildrenAsync(node.Id);
        var items = new List<ITreeViewItem>(children.Children.Count);
        foreach (var child in children.Children)
        {
            var item = Node(child.Dn, child.Rdn, child.HasChildren);
            await ExpandAsync(item, depth - 1);
            items.Add(item);
        }

        if (children.Truncated)
        {
            items.Add(new TreeViewItem
            {
                Id = TruncatedIdPrefix + node.Id,
                Text = "More children exist than were returned",
                Disabled = true,
            });
        }

        node.Items = items;
        node.Expanded = true;
    }

    /// <summary>Fetches children the first time a node is opened.</summary>
    private async Task LoadOnExpandAsync(TreeViewItemExpandedEventArgs args)
    {
        // Fires on collapse too; only a first open should query.
        if (!args.Expanded || args.CurrentItem is not TreeViewItem node || node.Items?.Any() == true)
        {
            return;
        }

        try
        {
            await ExpandAsync(node, depth: 1);
        }
        catch (DirectoryException ex)
        {
            _error = Describe(ex);
        }
    }

    private async Task OnSelectionChangedAsync()
    {
        // The truncation notice is a marker, not an entry; selecting it must not query.
        if (_selectedItem?.Id is { Length: > 0 } id && !id.StartsWith(TruncatedIdPrefix, StringComparison.Ordinal))
        {
            await SelectAsync(id, reveal: false);
        }
    }

    private async Task SelectAsync(string dn, bool reveal)
    {
        // Keep the address bar naming the entry on screen; replace, not push — selecting is
        // view state, and pushing would make Back step through every entry visited. The view
        // param is dropped deliberately: selecting an entry is a browse action, so a tree
        // click while the search or schema panel is open switches the pane to the editor.
        if (!string.Equals(DeepLinkDn, dn, StringComparison.Ordinal) || _view != AdminView.Browse)
        {
            Navigation.NavigateTo(Url(AdminView.Browse, dn), forceLoad: false, replace: true);
        }

        var token = ++_selectSeq;
        _selectedDn = dn;
        _entry = null;
        _error = null;
        _loadingEntry = true;
        LdapEntry? entry = null;
        string? error = null;
        try
        {
            entry = await Directory.GetEntryAsync(dn);
        }
        catch (DirectoryException ex)
        {
            error = Describe(ex);
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }

        if (token != _selectSeq)
        {
            // A newer selection owns the pane now; this response is stale and is dropped.
            return;
        }

        _loadingEntry = false;
        _entry = entry;
        _error = error ?? (entry is null ? $"No entry exists at '{dn}' (or this bind cannot see it)." : null);

        if (reveal && entry is not null)
        {
            await RevealAsync(dn, token);
        }
    }

    /// <summary>
    /// Expands the tree along the ancestor chain of <paramref name="dn"/> and selects its
    /// row, so a deep link lands on a visible, selected node rather than a collapsed root.
    /// </summary>
    private async Task RevealAsync(string dn, int token)
    {
        if (_roots is not [TreeViewItem root, ..])
        {
            return;
        }

        IReadOnlyList<RelativeDistinguishedName> target;
        IReadOnlyList<RelativeDistinguishedName> baseRdns;
        try
        {
            target = Dn.Parse(dn);
            baseRdns = Dn.Parse(Directory.BaseDn);
        }
        catch (ArgumentException)
        {
            return;
        }

        if (target.Count < baseRdns.Count
            || !string.Equals(Norm(target.Skip(target.Count - baseRdns.Count)), Norm(baseRdns), StringComparison.OrdinalIgnoreCase))
        {
            return; // Outside the tree this page shows.
        }

        var current = root;
        for (var take = baseRdns.Count + 1; take <= target.Count; take++)
        {
            var ancestor = Norm(target.Skip(target.Count - take));
            if (current.Items?.Any() != true && current.OnExpandedAsync is not null)
            {
                try
                {
                    await ExpandAsync(current, depth: 1);
                }
                catch (DirectoryException)
                {
                    return; // The entry pane already shows the entry; reveal is best-effort.
                }
                if (token != _selectSeq)
                {
                    return;
                }
            }

            var next = current.Items?
                .OfType<TreeViewItem>()
                .FirstOrDefault(item => item.Id is { } id
                    && !id.StartsWith(TruncatedIdPrefix, StringComparison.Ordinal)
                    && string.Equals(NormOrNull(id), ancestor, StringComparison.OrdinalIgnoreCase));
            if (next is null)
            {
                return; // Truncated out of the child list; the entry pane still shows it.
            }

            current.Expanded = true;
            current = next;
        }

        _selectedItem = current;
    }

    private static string Norm(IEnumerable<RelativeDistinguishedName> rdns) =>
        string.Join(',', rdns.Select(static rdn => rdn.ToString()));

    private static string? NormOrNull(string dn)
    {
        try
        {
            return Norm(Dn.Parse(dn));
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    // ---- Entry editing ------------------------------------------------------------------
    //
    // All four dialogs are provider-hosted (IDialogService + the components in
    // Components/Directory) rather than inline <FluentDialog> markup: inline, the FAST
    // dialog control keeps its stylesheet default fixed height (480px) with no overflow
    // handling, so form content taller than that renders past the dialog background — the
    // #104 defect class, one mechanism across all four. Each model carries its save
    // delegate; the dialog shows a returned error inline and closes only on null (success).

    /// <summary>DialogParameters shared by the four entry dialogs — one hosting shape, one fix.</summary>
    private static DialogParameters EntryDialogParameters(string title) => new()
    {
        Title = title,
        Width = "480px",
        Modal = true,
        TrapFocus = true,
        PreventScroll = true,
        ShowDismiss = true,
        // The content components render their own footers (Save/Cancel with busy state);
        // null hides the provider's default action buttons.
        PrimaryAction = null,
        SecondaryAction = null,
    };

    private async Task OpenEditAttributeDialog(LdapAttributeValues attribute)
    {
        var model = new AttributeDialogModel
        {
            IsNew = false,
            Name = attribute.Name,
            IsBinary = attribute.IsBinary,
            ValuesText = string.Join('\n', attribute.Values),
            SaveAsync = SaveAttributeAsync,
        };
        await ShowAndRefreshAsync(
            DialogService.ShowDialogAsync<AttributeDialog>(model, EntryDialogParameters($"Edit {attribute.Name}")));
    }

    private async Task OpenAddAttributeDialog()
    {
        var model = new AttributeDialogModel { IsNew = true, SaveAsync = SaveAttributeAsync };
        await ShowAndRefreshAsync(
            DialogService.ShowDialogAsync<AttributeDialog>(model, EntryDialogParameters("Add attribute")));
    }

    /// <summary>
    /// Awaits the dialog's close, then re-renders this page. The save delegates mutate this
    /// page's state (entry re-fetch, tree reloads, reveal), but they run in the dialog
    /// component's event context, so Blazor re-renders the dialog — not this page — when
    /// they finish. Measured in the browser pass: a successful save closed the dialog while
    /// the editor kept showing the pre-save entry until the next unrelated event.
    /// </summary>
    private async Task ShowAndRefreshAsync(Task<IDialogReference> showTask)
    {
        var dialog = await showTask;
        await dialog.Result;
        StateHasChanged();
    }

    private async Task OpenChildDialog()
    {
        if (_selectedDn is { } dn)
        {
            // The DN goes in the body (owned markup, overflow-wrap), never the title: a DN
            // is one unbreakable token, and its min-content width grows with tree depth —
            // in the title it pushes the dialog grid past the fixed control width, which
            // was the depth-dependent half of #104 (measured: title min-content 485px vs
            // 432px track at ou=directory depth).
            var model = new ChildDialogModel { ParentDn = dn, SaveAsync = SaveChildAsync };
            await ShowAndRefreshAsync(
                DialogService.ShowDialogAsync<NewChildDialog>(model, EntryDialogParameters("New child entry")));
        }
    }

    private async Task OpenRenameDialog()
    {
        if (_selectedDn is { } dn)
        {
            // Title stays DN-free for the same min-content reason as OpenChildDialog.
            var model = new RenameDialogModel { Dn = dn, SaveAsync = SaveRenameAsync };
            await ShowAndRefreshAsync(
                DialogService.ShowDialogAsync<RenameDialog>(model, EntryDialogParameters("Rename entry")));
        }
    }

    private async Task OpenDeleteDialog()
    {
        if (_selectedDn is { } dn)
        {
            var model = new DeleteDialogModel { Dn = dn, SaveAsync = ConfirmDeleteAsync };
            await ShowAndRefreshAsync(
                DialogService.ShowDialogAsync<DeleteDialog>(model, EntryDialogParameters("Delete entry")));
        }
    }

    /// <summary>Save delegates: null = success (the dialog closes); a string = shown inline.</summary>
    private async Task<string?> SaveAttributeAsync(AttributeDialogModel dialog)
    {
        if (_selectedDn is not { } dn)
        {
            return "No entry is selected.";
        }

        var values = Lines(dialog.ValuesText);
        if (dialog.IsNew && values.Count == 0)
        {
            return "Enter at least one value.";
        }

        var change = new LdapAttributeChange(
            dialog.IsNew ? DirectoryAttributeOperation.Add : DirectoryAttributeOperation.Replace,
            dialog.Name,
            values,
            IsBase64: dialog.IsBinary);
        var result = await GuardedAsync(() => Directory.ModifyEntryAsync(dn, [change]));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        Toasts.ShowSuccess($"{dialog.Name} saved");
        await SelectAsync(dn, reveal: false);
        return null;
    }

    private async Task<string?> SaveChildAsync(ChildDialogModel dialog)
    {
        var objectClasses = dialog.ObjectClasses
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (dialog.Rdn.Length == 0 || objectClasses.Length == 0)
        {
            return "An RDN and at least one object class are required.";
        }

        string childDn;
        try
        {
            childDn = Dn.Combine(dialog.Rdn, dialog.ParentDn);
        }
        catch (ArgumentException ex)
        {
            return ex.Message;
        }

        List<LdapNewAttribute> attributes = [new("objectClass", objectClasses)];
        foreach (var line in Lines(dialog.AttributesText))
        {
            var colon = line.IndexOf(':', StringComparison.Ordinal);
            if (colon <= 0)
            {
                return $"'{line}' is not in 'name: value' form.";
            }
            attributes.Add(new LdapNewAttribute(line[..colon].Trim(), [line[(colon + 1)..].Trim()]));
        }

        var result = await GuardedAsync(() => Directory.AddEntryAsync(new LdapNewEntry(childDn, attributes)));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        Toasts.ShowSuccess($"{childDn} created");
        await ReloadChildrenAsync(dialog.ParentDn);
        await SelectAsync(childDn, reveal: true);
        return null;
    }

    private async Task<string?> SaveRenameAsync(RenameDialogModel dialog)
    {
        var newParent = dialog.NewParentDn.Length > 0 ? dialog.NewParentDn : null;
        LdapRenameResult rename;
        try
        {
            rename = await Directory.RenameEntryAsync(dialog.Dn, dialog.NewRdn, newParent, dialog.DeleteOldRdn);
        }
        catch (DirectoryException ex)
        {
            rename = new LdapRenameResult(new LdapOperationResult(LdapOperationStatus.Failed, null, Describe(ex)), null);
        }

        if (!rename.Outcome.Succeeded || rename.NewDn is null)
        {
            return Describe(rename.Outcome);
        }

        Toasts.ShowSuccess($"Renamed to {rename.NewDn}");
        await ReloadChildrenAsync(ParentOf(dialog.Dn) ?? Directory.BaseDn);
        if (newParent is not null)
        {
            await ReloadChildrenAsync(newParent);
        }
        await SelectAsync(rename.NewDn, reveal: true);
        return null;
    }

    private async Task<string?> ConfirmDeleteAsync(DeleteDialogModel dialog)
    {
        var result = await GuardedAsync(() => Directory.DeleteEntryAsync(dialog.Dn));

        if (!result.Succeeded)
        {
            return Describe(result);
        }

        Toasts.ShowSuccess($"{dialog.Dn} deleted");
        var parent = ParentOf(dialog.Dn) ?? Directory.BaseDn;
        await ReloadChildrenAsync(parent);
        await SelectAsync(parent, reveal: true);
        return null;
    }

    /// <summary>Transport failures surface as an operation outcome, not a crash.</summary>
    private static async Task<LdapOperationResult> GuardedAsync(Func<Task<LdapOperationResult>> operation)
    {
        try
        {
            return await operation();
        }
        catch (DirectoryException ex)
        {
            return new LdapOperationResult(LdapOperationStatus.Failed, null, Describe(ex));
        }
    }

    /// <summary>Re-fetches one node's children after a write changed them.</summary>
    private async Task ReloadChildrenAsync(string parentDn)
    {
        if (NormOrNull(parentDn) is not { } norm || FindNode(norm) is not { } node)
        {
            return;
        }

        if (node.Items is not null)
        {
            node.Items = [];
            try
            {
                await ExpandAsync(node, depth: 1);
            }
            catch (DirectoryException ex)
            {
                _error = Describe(ex);
            }
        }
    }

    private TreeViewItem? FindNode(string normDn)
    {
        var pending = new Stack<TreeViewItem>((_roots ?? []).OfType<TreeViewItem>());
        while (pending.Count > 0)
        {
            var node = pending.Pop();
            if (node.Id is { } id
                && !id.StartsWith(TruncatedIdPrefix, StringComparison.Ordinal)
                && string.Equals(NormOrNull(id), normDn, StringComparison.OrdinalIgnoreCase))
            {
                return node;
            }
            foreach (var child in (node.Items ?? []).OfType<TreeViewItem>())
            {
                pending.Push(child);
            }
        }
        return null;
    }

    private static string? ParentOf(string dn)
    {
        try
        {
            var rdns = Dn.Parse(dn);
            return rdns.Count <= 1 ? null : Norm(rdns.Skip(1));
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    private static IReadOnlyList<string> Lines(string text) =>
        [.. text.Split('\n').Select(static line => line.TrimEnd('\r')).Where(static line => line.Length > 0)];

    /// <summary>The outcome classes a UI renders differently, in words.</summary>
    internal static string Describe(LdapOperationResult result)
    {
        var label = result.Status switch
        {
            LdapOperationStatus.NotFound => "The entry (or a parent it needs) does not exist",
            LdapOperationStatus.AlreadyExists => "An entry with that DN already exists",
            LdapOperationStatus.AccessDenied => "Access denied — the server's ACL refused this bind",
            LdapOperationStatus.NotAllowedOnNonLeaf => "The entry has children, so it cannot be deleted or moved",
            LdapOperationStatus.SchemaViolation => "The change contradicts the server's schema",
            LdapOperationStatus.ConstraintViolation => "The change violates a server constraint",
            LdapOperationStatus.InvalidRequest => "The request is not valid",
            LdapOperationStatus.Refused => "The server refused the request",
            LdapOperationStatus.Failed => $"The server reported {result.ResultCode?.ToString() ?? "an unmodelled error"}",
            _ => result.Status.ToString(),
        };
        return result.Message is { Length: > 0 } message ? $"{label}: {message}" : $"{label}.";
    }

    private static string Describe(DirectoryException ex) =>
        $"The directory could not be reached ({ex.GetType().Name}): {ex.Message}";
}
