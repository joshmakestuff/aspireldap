@*
    The server's subschema, straight from LdapSchemaService — LdifDotNet.Schema types render
    directly, no view-model mapping layer (docs/decisions.md § Architecture). Hosted in the
    contextual pane of the shell page (#102) — a panel, not a routed page, so the browse
    tree stays alive while the schema is open, and the loaded schema survives view switches.

    Layout per the design handoff § Schema: stacked .sec-headed Industry tables (object
    classes, attribute types, syntaxes) filtered by one client-side query.

    The unavailable state is shown, not inferred: an unreadable subschema and a directory
    that defines nothing look identical as data, so the service flags it and this panel says
    it out loud, with the reason. UnparsedDefinitions likewise: what the parser could not
    handle is listed rather than dropped.
*@
@using LdifDotNet.Schema
@inject LdapSchemaService SchemaService

<div class="dh">
    <div style="min-width: 0;">
        <h3 style="margin: 0;">Schema</h3>
        <div class="dnline mono">cn=subschema</div>
    </div>
</div>

@if (_schema is null)
{
    <p class="text-muted" style="font-size: 13px; margin-top: var(--space-4);">Loading schema…</p>
}
else if (!_schema.Available)
{
    <div class="bar err" role="alert" style="margin-top: var(--space-4);">
        The server's schema could not be read: @_schema.UnavailableReason
        Attribute values are classified by UTF-8 validity alone until it becomes readable.
    </div>
    <button class="btn btn-secondary" @onclick="LoadAsync">Retry</button>
}
else
{
    @* The filter is client-side over an already-loaded schema, so it narrows as you type;
       bound on 'change' it would only apply on blur, which reads as broken. *@
    <div style="margin-top: var(--space-4);">
        <input class="input mono" style="max-width: 30rem;" @bind="_query" @bind:event="oninput"
               placeholder="Filter by name, OID, or description" spellcheck="false"
               aria-label="Filter the schema" />
    </div>

    <div class="sec">Object classes — @FilteredClasses.Count</div>
    <table class="table">
        <thead>
            <tr>
                <th style="width: 22%;">Name</th>
                <th style="width: 12%;">Kind</th>
                <th>MUST / MAY</th>
                <th style="width: 18%;">SUP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var objectClass in FilteredClasses)
            {
                <tr>
                    <td class="mono">
                        @PrimaryName(objectClass.Names, objectClass.Oid)
                        @if (objectClass.Obsolete)
                        {
                            <i class="tk mono" style="margin-left: 6px;">obsolete</i>
                        }
                    </td>
                    <td class="mono text-muted">@objectClass.Kind</td>
                    <td class="mono" style="font-size: 12px;">
                        @if (objectClass.Must.Count > 0)
                        {
                            <div><b>MUST</b> @string.Join(", ", objectClass.Must)</div>
                        }
                        @if (objectClass.May.Count > 0)
                        {
                            <div class="text-muted" title="@string.Join(", ", objectClass.May)">MAY @Summarize(objectClass.May)</div>
                        }
                    </td>
                    <td class="mono text-muted">@string.Join(", ", objectClass.SuperiorNames)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="sec">Attribute types — @FilteredAttributes.Count</div>
    <table class="table">
        <thead>
            <tr>
                <th style="width: 22%;">Name</th>
                <th>Description</th>
                <th style="width: 20%;">Syntax</th>
                <th style="width: 14%;">SUP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attributeType in FilteredAttributes)
            {
                <tr>
                    <td class="mono">
                        @PrimaryName(attributeType.Names, attributeType.Oid)
                        @if (attributeType.SingleValue)
                        {
                            <i class="tk mono" style="margin-left: 6px;">single</i>
                        }
                        @if (attributeType.NoUserModification)
                        {
                            <i class="tk mono" style="margin-left: 6px;">read-only</i>
                        }
                        @if (attributeType.Obsolete)
                        {
                            <i class="tk mono" style="margin-left: 6px;">obsolete</i>
                        }
                    </td>
                    <td style="font-size: 13px;">@attributeType.Description</td>
                    <td class="mono text-muted"><span title="@attributeType.Syntax">@SyntaxLabel(attributeType.Syntax)</span></td>
                    <td class="mono text-muted">@attributeType.SuperiorName</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="sec">Syntaxes — @FilteredSyntaxes.Count</div>
    <table class="table">
        <thead>
            <tr>
                <th style="width: 28%;">OID</th>
                <th>Description</th>
                <th style="width: 22%;">Transfer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var syntax in FilteredSyntaxes)
            {
                <tr>
                    <td class="mono">@syntax.Oid</td>
                    <td style="font-size: 13px;">@syntax.Description</td>
                    <td>
                        @if (syntax.NotHumanReadable)
                        {
                            <i class="tk mono">binary</i>
                        }
                        @if (syntax.BinaryTransferRequired)
                        {
                            <i class="tk mono" style="margin-left: 6px;">;binary required</i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_schema.Schema.UnparsedDefinitions.Count > 0)
    {
        <div class="sec">Unparsed — @_schema.Schema.UnparsedDefinitions.Count</div>
        <p class="text-muted" style="font-size: 13px;">
            Definitions the parser could not interpret. They are listed rather than dropped,
            so nothing in the server's schema is invisible here.
        </p>
        @foreach (var unparsed in _schema.Schema.UnparsedDefinitions)
        {
            <p style="font-size: 13px; margin-bottom: var(--space-1);">@unparsed.Kind — @unparsed.Error</p>
            <div class="pre mono">@unparsed.Definition</div>
        }
    }
}

@code {
    private LdapSchemaResult? _schema;
    private string _query = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // The service reports an unreadable schema as data (Available = false) rather than
        // throwing, so there is no catch here: every outcome renders.
        _schema = await SchemaService.GetSchemaAsync();
    }

    private IReadOnlyList<LdapObjectClass> FilteredClasses =>
        _schema is null
            ? []
            : [.. _schema.Schema.ObjectClasses.Where(c => Matches(c.Names, c.Oid, c.Description))];

    private IReadOnlyList<LdapAttributeType> FilteredAttributes =>
        _schema is null
            ? []
            : [.. _schema.Schema.AttributeTypes.Where(a => Matches(a.Names, a.Oid, a.Description))];

    private IReadOnlyList<LdapSyntax> FilteredSyntaxes =>
        _schema is null
            ? []
            : [.. _schema.Schema.Syntaxes.Where(s => Matches(s.Names, s.Oid, s.Description))];

    private bool Matches(IReadOnlyList<string> names, string oid, string? description)
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return true;
        }

        return names.Any(n => n.Contains(_query, StringComparison.OrdinalIgnoreCase))
            || oid.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || (description?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static string PrimaryName(IReadOnlyList<string> names, string oid) =>
        names.Count > 0 ? names[0] : oid;

    /// <summary>Keeps a long MAY list from swallowing the row; the full list is in the title.</summary>
    private static string Summarize(IReadOnlyList<string> values) =>
        values.Count <= 6
            ? string.Join(", ", values)
            : $"{string.Join(", ", values.Take(6))} +{values.Count - 6} more";

    private string SyntaxLabel(string? oid)
    {
        if (oid is null)
        {
            return string.Empty;
        }

        // Prefer the server's own description over the raw OID — the subschema already
        // carries it, and "Directory String" beats a dotted OID for every reader.
        var known = _schema?.Schema.Syntaxes.FirstOrDefault(s => string.Equals(s.Oid, oid, StringComparison.Ordinal));
        return known?.Description is { Length: > 0 } description ? description : oid;
    }
}
