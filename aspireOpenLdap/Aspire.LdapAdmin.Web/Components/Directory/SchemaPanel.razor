@*
    The server's subschema, straight from LdapSchemaService — LdifDotNet.Schema types render
    directly, no view-model mapping layer. Hosted in the
    contextual pane of the shell page — a panel, not a routed page, so the browse
    tree stays alive while the schema is open, and the loaded schema survives view switches.

    Layout: stacked .sec-headed Industry tables (object classes, attribute types,
    syntaxes, unparsed) filtered by one client-side query; a .seg of per-kind toggles
    shows or hides each definition kind independently (#116).

    The unavailable state is shown, not inferred: an unreadable subschema and a directory
    that defines nothing look identical as data, so the service flags it and this panel says
    it out loud, with the reason. UnparsedDefinitions likewise: what the parser could not
    handle is listed rather than dropped.
*@
@using LdifDotNet.Schema
@implements IDisposable
@inject LdapSchemaService SchemaService

<div class="dh">
    <div style="min-width: 0;">
        <h3 style="margin: 0;">Schema</h3>
        <div class="dnline mono">cn=subschema</div>
    </div>
</div>

@if (_schema is null)
{
    <p class="text-muted note" style="margin-top: var(--space-4);">Loading schema…</p>
}
else if (!_schema.Available)
{
    <div class="bar err" role="alert" style="margin-top: var(--space-4);">
        The server's schema could not be read: @_schema.UnavailableReason
        Attribute values are classified by UTF-8 validity alone until it becomes readable.
    </div>
    <button class="btn btn-secondary" @onclick="LoadAsync">Retry</button>
}
else
{
    @* The filter is client-side over an already-loaded schema, so it narrows as you type;
       bound on 'change' it would only apply on blur. Debounced: applying on every keystroke
       re-filters all three tables synchronously per key. *@
    <div style="margin-top: var(--space-4);">
        <input class="input mono" style="max-width: 30rem;" @bind="_queryInput" @bind:event="oninput"
               @bind:after="DebounceFilterAsync"
               placeholder="Filter by name, OID, or description" spellcheck="false"
               aria-label="Filter the schema" />
    </div>

    <div class="seg" role="group" aria-label="Show schema definition kinds"
         style="margin-top: var(--space-3);">
        <label class="seg-opt mono">
            <input type="checkbox" @bind="_showClasses" />
            Classes
        </label>
        <label class="seg-opt mono">
            <input type="checkbox" @bind="_showAttributes" />
            Attribute types
        </label>
        <label class="seg-opt mono">
            <input type="checkbox" @bind="_showSyntaxes" />
            Syntaxes
        </label>
        @if (HasUnparsed)
        {
            <label class="seg-opt mono">
                <input type="checkbox" @bind="_showUnparsed" />
                Unparsed
            </label>
        }
    </div>

    @if (!AnyKindShown)
    {
        <p class="text-muted note" style="margin-top: var(--space-4);">
            No definition kinds are shown — enable at least one kind above.
        </p>
    }

    @if (_showClasses)
    {
        <div class="sec">Object classes — @_filteredClasses.Count</div>
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 22%;">Name</th>
                    <th style="width: 12%;">Kind</th>
                    <th>MUST / MAY</th>
                    <th style="width: 18%;">SUP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var objectClass in _filteredClasses)
                {
                    <tr>
                        <td class="mono">
                            @PrimaryName(objectClass.Names, objectClass.Oid)
                            @if (objectClass.Obsolete)
                            {
                                <i class="tk mono" style="margin-left: 6px;">obsolete</i>
                            }
                        </td>
                        <td class="mono text-muted">@objectClass.Kind</td>
                        <td class="mono">
                            @if (objectClass.Must.Count > 0)
                            {
                                <div><b>MUST</b> @string.Join(", ", objectClass.Must)</div>
                            }
                            @if (objectClass.May.Count > 0)
                            {
                                <div class="text-muted" title="@string.Join(", ", objectClass.May)">MAY @Summarize(objectClass.May)</div>
                            }
                        </td>
                        <td class="mono text-muted">@string.Join(", ", objectClass.SuperiorNames)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_showAttributes)
    {
        <div class="sec">Attribute types — @_filteredAttributes.Count</div>
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 22%;">Name</th>
                    <th>Description</th>
                    <th style="width: 20%;">Syntax</th>
                    <th style="width: 14%;">SUP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attributeType in _filteredAttributes)
                {
                    <tr>
                        <td class="mono">
                            @PrimaryName(attributeType.Names, attributeType.Oid)
                            @if (attributeType.SingleValue)
                            {
                                <i class="tk mono" style="margin-left: 6px;">single</i>
                            }
                            @if (attributeType.NoUserModification)
                            {
                                <i class="tk mono" style="margin-left: 6px;">read-only</i>
                            }
                            @if (attributeType.Obsolete)
                            {
                                <i class="tk mono" style="margin-left: 6px;">obsolete</i>
                            }
                        </td>
                        <td class="note">@attributeType.Description</td>
                        <td class="mono text-muted"><span title="@attributeType.Syntax">@SyntaxLabel(attributeType.Syntax)</span></td>
                        <td class="mono text-muted">@attributeType.SuperiorName</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_showSyntaxes)
    {
        <div class="sec">Syntaxes — @_filteredSyntaxes.Count</div>
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 28%;">OID</th>
                    <th>Description</th>
                    <th style="width: 22%;">Transfer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var syntax in _filteredSyntaxes)
                {
                    <tr>
                        <td class="mono">@syntax.Oid</td>
                        <td class="note">@syntax.Description</td>
                        <td>
                            @if (syntax.NotHumanReadable)
                            {
                                <i class="tk mono">binary</i>
                            }
                            @if (syntax.BinaryTransferRequired)
                            {
                                <i class="tk mono" style="margin-left: 6px;">;binary required</i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (HasUnparsed && _showUnparsed)
    {
        <div class="sec">Unparsed — @_schema.Schema.UnparsedDefinitions.Count</div>
        <p class="text-muted note">
            Definitions the parser could not interpret. They are listed rather than dropped,
            so nothing in the server's schema is invisible here.
        </p>
        @foreach (var unparsed in _schema.Schema.UnparsedDefinitions)
        {
            <p class="note" style="margin-bottom: var(--space-1);">@unparsed.Kind — @unparsed.Error</p>
            <div class="pre mono">@unparsed.Definition</div>
        }
    }
}

@code {
    private LdapSchemaResult? _schema;

    /// <summary>What the input holds right now; becomes the applied filter after the debounce.</summary>
    private string _queryInput = string.Empty;

    /// <summary>The applied filter the three tables render from.</summary>
    private string _query = string.Empty;

    /// <summary>Per-kind visibility, all shown by default (#116).</summary>
    private bool _showClasses = true;
    private bool _showAttributes = true;
    private bool _showSyntaxes = true;
    private bool _showUnparsed = true;

    /// <summary>Whether the server published any definitions the parser could not handle.</summary>
    private bool HasUnparsed => _schema?.Schema.UnparsedDefinitions.Count > 0;

    /// <summary>
    /// Whether at least one definition kind has a visible section. When the server has no
    /// unparsed definitions there is no Unparsed section at all, so the Unparsed flag only
    /// counts when such a section exists.
    /// </summary>
    private bool AnyKindShown =>
        _showClasses || _showAttributes || _showSyntaxes || (HasUnparsed && _showUnparsed);

    private CancellationTokenSource? _debounceCts;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Applies the typed query 200 ms after the last keystroke: each keystroke cancels the
    /// pending apply, so the three tables
    /// re-filter once per pause instead of once per key.
    /// </summary>
    private async Task DebounceFilterAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        var cts = _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(200), cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // A newer keystroke owns the apply.
        }
        _query = _queryInput;
        ApplyFilter();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }

    private async Task LoadAsync()
    {
        // The service reports an unreadable schema as data (Available = false) rather than
        // throwing, so there is no catch here: every outcome renders.
        _schema = await SchemaService.GetSchemaAsync();
        ApplyFilter();
    }

    // Filtered once per applied query (ApplyFilter), not per render: renders happen on
    // every keystroke, and computed-property filtering would still sweep all three lists
    // each time even while the debounce holds the query steady.
    private IReadOnlyList<LdapObjectClass> _filteredClasses = [];
    private IReadOnlyList<LdapAttributeType> _filteredAttributes = [];
    private IReadOnlyList<LdapSyntax> _filteredSyntaxes = [];

    private void ApplyFilter()
    {
        _filteredClasses = _schema is null
            ? []
            : [.. _schema.Schema.ObjectClasses.Where(c => Matches(c.Names, c.Oid, c.Description))];
        _filteredAttributes = _schema is null
            ? []
            : [.. _schema.Schema.AttributeTypes.Where(a => Matches(a.Names, a.Oid, a.Description))];
        _filteredSyntaxes = _schema is null
            ? []
            : [.. _schema.Schema.Syntaxes.Where(s => Matches(s.Names, s.Oid, s.Description))];
    }

    /// <summary>
    /// One match implementation shared with the rows the tables render
    /// (<see cref="SchemaFilter.Matches"/>), so the filter path and the display path
    /// cannot disagree about a definition (aspireldap#116 — "filtering by OID returns
    /// nothing" while the predicate source looked right).
    /// </summary>
    private bool Matches(IReadOnlyList<string> names, string oid, string? description) =>
        SchemaFilter.Matches(_query, names, oid, description);

    private static string PrimaryName(IReadOnlyList<string> names, string oid) =>
        names.Count > 0 ? names[0] : oid;

    /// <summary>Keeps a long MAY list from swallowing the row; the full list is in the title.</summary>
    private static string Summarize(IReadOnlyList<string> values) =>
        values.Count <= 6
            ? string.Join(", ", values)
            : $"{string.Join(", ", values.Take(6))} +{values.Count - 6} more";

    private string SyntaxLabel(string? oid)
    {
        if (oid is null)
        {
            return string.Empty;
        }

        // Prefer the server's own description over the raw OID — the subschema already
        // carries it, and "Directory String" beats a dotted OID for every reader.
        var known = _schema?.Schema.Syntaxes.FirstOrDefault(s => string.Equals(s.Oid, oid, StringComparison.Ordinal));
        return known?.Description is { Length: > 0 } description ? description : oid;
    }
}
