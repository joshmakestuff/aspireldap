@*
    LDAP filter search over LdapDirectoryService, in-process, in the design handoff's
    Search layout: the raw RFC 4515 filter first and full-width, the scope controls in a
    grid beneath it, results as an Industry .table. Hosted in the contextual pane of the
    shell page (#102) — a panel, not a routed page, so the browse tree stays alive while
    the user searches. Clicking a result raises OnEntrySelected; the shell selects +
    reveals the entry in the tree and switches the pane to the editor.

    The service owns filter validation and truncation reporting; an invalid filter comes
    back as a typed result and is shown as-is. Truncation is surfaced, never hidden — a
    silently short result set reads as "no such entry", the one wrong answer a directory
    browser must not give.

    The tree's capped "search this container" row lands here via PresetAndRunAsync
    (design handoff § Tree behavior): base = the capped container, scope = one level,
    filter reset to (objectClass=*), run immediately so it arrives on real results.
*@
@using System.DirectoryServices.Protocols
@using LdifDotNet
@inject LdapDirectoryService Directory
@inject LdapAdminSettings Settings
@inject ConsoleClipboard Clipboard
@inject ConsoleToastService Toasts

<div class="dh">
    <div style="min-width: 0;">
        <h3 style="margin: 0;">Search</h3>
        <div class="dnline">RFC 4515 filter over the directory; Enter runs it.</div>
    </div>
</div>

<div class="sec">Raw filter — RFC 4515</div>
<input class="input mono" @bind="_filter" @bind:event="oninput" @onkeydown="OnFilterKeyDown"
       placeholder="(objectClass=inetOrgPerson)" spellcheck="false" aria-label="LDAP filter" />

<div class="grid2" style="margin-top: var(--space-3);">
    <div class="field">
        <label>Search base <span class="text-muted">(empty = @Directory.BaseDn)</span></label>
        <input class="input mono" @bind="_baseDn" @onkeydown="OnFilterKeyDown" spellcheck="false" />
    </div>
    <div class="field">
        <label>Scope</label>
        <select class="input mono" @bind="_scope">
            <option value="@SearchScope.Subtree">subtree</option>
            <option value="@SearchScope.OneLevel">onelevel</option>
            <option value="@SearchScope.Base">base</option>
        </select>
    </div>
    <div class="field">
        <label>Limit</label>
        <input class="input mono" type="number" min="1" max="1000" @bind="_limit" />
    </div>
    <div class="field">
        <label>&nbsp;</label>
        <button class="btn btn-primary" disabled="@_running" @onclick="RunAsync">
            @(_running ? "Searching…" : "Search")
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="bar err" role="alert" style="margin-top: var(--space-4);">@_error</div>
}

@if (_result is not null)
{
    <div class="sec">
        @(_result.Entries.Count == 1 ? "1 entry returned" : $"{_result.Entries.Count} entries returned")
        @* The stripped suffix is stated, not implied: relative DNs with no stated base
           are ambiguous, which is the one failure mode stripping must not introduce. *@
        @if (_commonSuffix.Length > 0)
        {
            <span class="mono" style="text-transform: none; letter-spacing: 0;">— all under @_commonSuffix</span>
        }
    </div>

    @if (_result.Truncated)
    {
        <div class="bar">
            Showing the first @_result.Entries.Count entries — the directory has more. Raise
            the limit or narrow the filter.
        </div>
    }

    @if (_result.Entries.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>DN</th>
                    <th style="width: 22%;">Name</th>
                    <th style="width: 22%;">Mail</th>
                    <th style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _displayEntries)
                {
                    <tr>
                        <td class="mono">
                            @* The whole meaning of the row is "open this entry", so the DN is
                               the link; the full DN rides the title and the copy button. *@
                            <a href="#" title="@entry.Dn"
                               @onclick="@(() => OnEntrySelected.InvokeAsync(entry.Dn))"
                               @onclick:preventDefault="true">@DnDisplay.Relative(entry.Dn, _commonSuffix)</a>
                        </td>
                        <td>@First(entry, "cn", "displayName", "ou", "o")</td>
                        <td class="mono">@First(entry, "mail")</td>
                        <td>
                            <button class="btn btn-ghost btn-sm" title="Copy full DN to clipboard"
                                    @onclick="@(() => CopyDnAsync(entry.Dn))">Copy</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted" style="font-size: 13px;">No entry matched. <span class="mono">@_filter</span></p>
    }
}

@code {
    /// <summary>Raised with the full DN of a clicked result row; the shell owns what happens next.</summary>
    [Parameter]
    public EventCallback<string> OnEntrySelected { get; set; }

    private string _filter = "(objectClass=*)";
    private string _baseDn = string.Empty;
    private SearchScope _scope = SearchScope.Subtree;
    private int? _limit;

    private LdapSearchResult? _result;
    private List<LdapEntry> _displayEntries = [];
    private string _commonSuffix = string.Empty;
    private string? _error;
    private bool _running;

    protected override void OnInitialized()
    {
        // The initial size limit is an AppHost-set default (#98); the field stays editable
        // per search — a default, not a ceiling.
        _limit = Settings.DefaultSearchLimit;
    }

    /// <summary>
    /// Stale-response guard: a run that finishes after a newer run started is discarded, so
    /// an old result set can never replace the one the user asked for last.
    /// </summary>
    private int _runSeq;

    /// <summary>The tree's capped-container handoff: preset the query and run it now.</summary>
    public Task PresetAndRunAsync(string baseDn, SearchScope scope, string filter)
    {
        _baseDn = baseDn;
        _scope = scope;
        _filter = filter;
        return RunAsync();
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs args)
    {
        // Enter runs the search: typing a filter and reaching for the mouse is the wrong
        // rhythm for the one control on this page you use every time.
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await RunAsync();
        }
    }

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            _error = "Enter a filter.";
            return;
        }

        var token = ++_runSeq;
        _running = true;
        _error = null;
        LdapSearchResult? result = null;
        string? error = null;
        try
        {
            result = await Directory.SearchAsync(new LdapSearchOptions
            {
                Filter = _filter,
                BaseDn = string.IsNullOrWhiteSpace(_baseDn) ? null : _baseDn,
                Scope = _scope,
                Limit = _limit ?? Settings.DefaultSearchLimit,
            });
        }
        catch (DirectoryException ex)
        {
            error = $"The search failed ({ex.GetType().Name}): {ex.Message}";
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }

        if (token != _runSeq)
        {
            return;
        }

        _running = false;
        _error = error;
        _result = result;
        _commonSuffix = result is null ? string.Empty : DnDisplay.CommonSuffix([.. result.Entries.Select(static e => e.Dn)]);
        // Display order only — the AppHost-set default (#98). Sorting happens after the
        // (truncation-aware) fetch, so it never changes which entries came back, and it keys
        // on the same relative form the DN column shows.
        _displayEntries = result is null ? [] : [.. result.Entries];
        if (Settings.DefaultSortOrder == LdapAdminSortOrder.Rdn)
        {
            _displayEntries.Sort((a, b) => string.Compare(
                DnDisplay.Relative(a.Dn, _commonSuffix),
                DnDisplay.Relative(b.Dn, _commonSuffix),
                StringComparison.OrdinalIgnoreCase));
        }

        StateHasChanged();
    }

    private async Task CopyDnAsync(string dn) =>
        Toasts.Show(await Clipboard.CopyAsync(dn) ? "DN copied" : "copy failed — clipboard unavailable");

    /// <summary>
    /// First non-empty value among <paramref name="names"/>, in preference order, so the
    /// column stays populated across the object classes one filter can return. Binary
    /// values are skipped: their transport form is base64, which is not a label.
    /// </summary>
    private static string First(LdapEntry entry, params string[] names)
    {
        foreach (var name in names)
        {
            var attribute = entry.Attributes.FirstOrDefault(
                a => a.Name.Equals(name, StringComparison.OrdinalIgnoreCase) && !a.IsBinary);
            if (attribute?.Values.FirstOrDefault(static v => v.Length > 0) is { } value)
            {
                return value;
            }
        }
        return string.Empty;
    }
}
