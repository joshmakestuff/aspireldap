@*
    LDAP filter search over LdapDirectoryService, in-process: the raw RFC 4515 filter
    first and full-width, the scope controls in a grid beneath it, results as an Industry
    .table. Hosted in the contextual pane of the shell page — a panel, not a routed page,
    so the browse tree stays alive while the user searches. Clicking a result raises
    OnEntrySelected; the shell selects + reveals the entry in the tree and switches the
    pane to the editor.

    The service owns filter validation and truncation reporting; an invalid filter comes
    back as a typed result and is shown as-is. Truncation is surfaced, never hidden — a
    silently short result set reads as "no such entry", the one wrong answer a directory
    browser must not give.

    The tree's capped "search this container" row lands here via PresetAndRunAsync:
    base = the capped container, scope = one level, filter reset to (objectClass=*),
    run immediately so it arrives on real results.
*@
@using System.DirectoryServices.Protocols
@using System.Collections.Immutable
@using LdifDotNet
@using LdifDotNet.Schema
@inject LdapDirectoryService Directory
@inject LdapSchemaService SchemaService
@inject LdapAdminSettings Settings
@inject ConsoleClipboard Clipboard
@inject ConsoleToastService Toasts

<div class="dh">
    <div style="min-width: 0;">
        <h3 style="margin: 0;">Search</h3>
        <div class="dnline">Filter builder over the DIT — the raw filter stays in sync both ways. Enter runs it.</div>
    </div>
</div>

<div class="sec">Raw filter — RFC 4515</div>
<input class="input mono" value="@RawFilter" @oninput="OnRawInput" @onkeydown="OnFilterKeyDown"
       placeholder="(objectClass=inetOrgPerson)" spellcheck="false" aria-label="LDAP filter" />

@* Query builder. The builder is the raw filter's flat
   projection: once the raw field is hand-edited it wins, and the rows below merely
   mirror what of it they can represent — until a builder control is touched, which
   adopts the projection and regenerates the raw filter from it. *@
<div class="sec" style="margin-top: var(--space-4);">
    Query builder
    <button class="btn btn-ghost btn-sm" style="order: 1; text-transform: none;"
            @onclick="@(() => _builderOpen = !_builderOpen)">@(_builderOpen ? "Hide" : "Show")</button>
</div>

@if (_builderOpen)
{
    <div class="grid2">
        <div class="field">
            <label>Search base <span class="text-muted">(empty = @Directory.BaseDn)</span></label>
            <input class="input mono" @bind="_baseDn" @onkeydown="OnFilterKeyDown" spellcheck="false"
                   list="search-base-options" aria-label="Search base" />
            <datalist id="search-base-options">
                @foreach (var option in _baseOptions)
                {
                    <option value="@option"></option>
                }
            </datalist>
        </div>
        <div class="field">
            <label>Scope</label>
            <select class="input mono" @bind="_scope">
                <option value="@SearchScope.Subtree">subtree</option>
                <option value="@SearchScope.OneLevel">onelevel</option>
                <option value="@SearchScope.Base">base</option>
            </select>
        </div>
        <div class="field">
            <label>Join</label>
            <div class="seg" role="group" aria-label="Condition join">
                <label class="seg-opt mono">
                    <input type="radio" name="filter-join" checked="@(DisplayJoin == LdapFilterJoin.All)"
                           @onchange="@(() => SetJoin(LdapFilterJoin.All))" />
                    &amp; all
                </label>
                <label class="seg-opt mono">
                    <input type="radio" name="filter-join" checked="@(DisplayJoin == LdapFilterJoin.Any)"
                           @onchange="@(() => SetJoin(LdapFilterJoin.Any))" />
                    | any
                </label>
            </div>
        </div>
        <div class="field">
            <label>Limit</label>
            <input class="input mono" type="number" min="1" max="1000" @bind="_limit" />
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <button class="btn btn-primary" disabled="@_running" @onclick="RunAsync">
                @(_running ? "Searching…" : "Search")
            </button>
        </div>
    </div>

    var rows = DisplayRows;
    <div style="margin-top: var(--space-3);">
        @for (var i = 0; i < rows.Count; i++)
        {
            var index = i;
            var row = rows[index];
            <div class="frow">
                <input class="input mono" value="@row.Attribute" placeholder="attribute" spellcheck="false"
                       aria-label="Condition attribute" @onkeydown="OnFilterKeyDown"
                       @oninput="e => SetAttribute(index, e.Value?.ToString() ?? string.Empty)" />
                <select class="input mono" value="@OperatorKey(row.Operator)" aria-label="Condition operator"
                        @onchange="e => SetOperator(index, e.Value?.ToString() ?? string.Empty)">
                    <option value="eq">=</option>
                    <option value="present">present</option>
                    <option value="ge">&gt;=</option>
                    <option value="le">&lt;=</option>
                </select>
                <input class="input mono" value="@row.Value" spellcheck="false" aria-label="Condition value"
                       disabled="@(row.Operator == LdapFilterOperator.Present)"
                       title="@(row.Operator == LdapFilterOperator.Present ? "Presence has no value" : null)"
                       @onkeydown="OnFilterKeyDown"
                       @oninput="e => SetValue(index, e.Value?.ToString() ?? string.Empty)" />
                <button class="btn btn-ghost btn-sm" title="Remove condition" aria-label="Remove condition"
                        @onclick="() => RemoveCondition(index)">×</button>
            </div>
        }
        <button class="btn btn-secondary btn-sm" @onclick="AddCondition">Add condition</button>
        @if (RawIsLossy)
        {
            <p class="text-muted note" style="margin-top: var(--space-2);">
                The raw filter holds structure the builder cannot show; touching a builder
                control rewrites it to just the rows above.
            </p>
        }
    </div>
}
else
{
    <div style="margin-top: var(--space-3);">
        <button class="btn btn-primary" disabled="@_running" @onclick="RunAsync">
            @(_running ? "Searching…" : "Search")
        </button>
    </div>
}

@if (_error is not null)
{
    <div class="bar err" role="alert" style="margin-top: var(--space-4);">@_error</div>
}

@if (_result is not null)
{
    <div class="search-selection-slot">
        @if (_selected.Count > 0)
        {
            <div class="bar search-selection" role="status">
                <b class="mono">@_selected.Count</b> selected
                <button class="btn btn-ghost btn-sm" @onclick="ClearSelection">Clear</button>
                <span class="search-selection-spacer"></span>
                <span class="hint">Only checked fetched rows are affected.</span>
                <button class="btn btn-primary" @onclick="OpenBulkEdit">Bulk edit…</button>
            </div>
        }
    </div>
    <SearchResultsTable Result="_result" CommonSuffix="@_commonSuffix" RanFilter="@_ranFilter"
                        InitialSortOrder="Settings.DefaultSortOrder"
                        SelectionDisabled="_running"
                        SelectedDns="SelectedDns" OnSelectionChanged="SetSelection"
                        OnEntrySelected="OnEntrySelected" OnCopyDn="CopyDnAsync" />
}

@if (_bulkEdit is { } bulkEdit)
{
    <BulkEditDialog Model="bulkEdit" OnClose="CloseBulkEdit" />
}

@code {
    /// <summary>Raised with the full DN of a clicked result row; the shell owns what happens next.</summary>
    [Parameter]
    public EventCallback<string> OnEntrySelected { get; set; }

    private string _baseDn = string.Empty;
    private SearchScope _scope = SearchScope.Subtree;
    private int? _limit;

    // ---- Query builder state ------------------------------------------------------------
    // The builder rows and join are canonical until the raw filter is hand-edited
    // (_rawEdited != null); from then the raw string wins and the rows shown are its flat
    // projection, until a builder control is touched (Adopt), which materializes that
    // projection and regenerates the raw filter from it.

    private bool _builderOpen = true;
    private List<ConditionRow> _conds = [new() { Attribute = "objectClass", Operator = LdapFilterOperator.Present }];
    private LdapFilterJoin _join = LdapFilterJoin.All;
    private string? _rawEdited;
    private IReadOnlyList<string> _baseOptions = [];

    /// <summary>The filter the search runs and the raw field shows.</summary>
    private string RawFilter => _rawEdited ?? LdapFilterConditions.Compose(
        _conds.Select(static c => c.ToCondition()), _join);

    private LdapFilterParse? RawProjection =>
        _rawEdited is null ? null : LdapFilterConditions.Parse(_rawEdited);

    private List<ConditionRow> DisplayRows =>
        RawProjection is { } parse ? [.. parse.Conditions.Select(ConditionRow.From)] : _conds;

    private LdapFilterJoin DisplayJoin => RawProjection?.Join ?? _join;

    private bool RawIsLossy => RawProjection is { Lossy: true };

    private void OnRawInput(ChangeEventArgs args) => _rawEdited = args.Value?.ToString() ?? string.Empty;

    /// <summary>A builder control was touched: the raw projection becomes the state again.</summary>
    private void Adopt()
    {
        if (RawProjection is { } parse)
        {
            _conds = [.. parse.Conditions.Select(ConditionRow.From)];
            _join = parse.Join;
            _rawEdited = null;
        }
    }

    private void SetJoin(LdapFilterJoin join)
    {
        Adopt();
        _join = join;
    }

    private void SetAttribute(int index, string value)
    {
        Adopt();
        _conds[index].Attribute = value;
    }

    private void SetOperator(int index, string key)
    {
        Adopt();
        _conds[index].Operator = key switch
        {
            "present" => LdapFilterOperator.Present,
            "ge" => LdapFilterOperator.GreaterOrEqual,
            "le" => LdapFilterOperator.LessOrEqual,
            _ => LdapFilterOperator.Equals,
        };
    }

    private void SetValue(int index, string value)
    {
        Adopt();
        _conds[index].Value = value;
    }

    private void AddCondition()
    {
        Adopt();
        _conds.Add(new ConditionRow());
    }

    private void RemoveCondition(int index)
    {
        Adopt();
        _conds.RemoveAt(index);
    }

    private static string OperatorKey(LdapFilterOperator op) => op switch
    {
        LdapFilterOperator.Present => "present",
        LdapFilterOperator.GreaterOrEqual => "ge",
        LdapFilterOperator.LessOrEqual => "le",
        _ => "eq",
    };

    /// <summary>One mutable builder row; the record form is what compose/parse speak.</summary>
    internal sealed class ConditionRow
    {
        public string Attribute { get; set; } = string.Empty;
        public LdapFilterOperator Operator { get; set; } = LdapFilterOperator.Equals;
        public string Value { get; set; } = string.Empty;

        public LdapFilterCondition ToCondition() => new(Attribute, Operator, Value);

        public static ConditionRow From(LdapFilterCondition condition) => new()
        {
            Attribute = condition.Attribute,
            Operator = condition.Operator,
            Value = condition.Value,
        };
    }

    private LdapSearchResult? _result;
    private string _commonSuffix = string.Empty;
    private string? _error;
    private string _ranFilter = string.Empty;
    private bool _running;
    private readonly Dictionary<string, LdapEntry> _selected = new(StringComparer.Ordinal);
    private LdifDotNet.Schema.LdapSchema? _schema;
    private BulkEditDialogModel? _bulkEdit;
    private IReadOnlySet<string> SelectedDns => _selected.Keys.ToHashSet(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        // The initial size limit is an AppHost-set default; the field stays editable
        // per search — a default, not a ceiling.
        _limit = Settings.DefaultSearchLimit;
    }

    /// <summary>
    /// Search-base suggestions: the base DN plus the directory's OUs, loaded once after
    /// first render. A datalist, not a select — a pasted or exotic base must stay typable.
    /// Loading is a convenience; failure just leaves the list empty.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var ous = await Directory.SearchAsync(new LdapSearchOptions
            {
                Filter = "(objectClass=organizationalUnit)",
                Attributes = ["objectClass"],
                Limit = 200,
            });
            _baseOptions = [Directory.BaseDn, .. ous.Entries.Select(static e => e.Dn)];
            StateHasChanged();
        }
        catch (DirectoryException)
        {
        }

        try
        {
            var schema = await SchemaService.GetSchemaAsync();
            _schema = schema.Available ? schema.Schema : null;
        }
        catch (DirectoryException)
        {
        }
    }

    /// <summary>
    /// Stale-response guard: a run that finishes after a newer run started is discarded, so
    /// an old result set can never replace the one the user asked for last.
    /// </summary>
    private int _runSeq;

    /// <summary>The tree's capped-container handoff: preset the query and run it now.</summary>
    public Task PresetAndRunAsync(string baseDn, SearchScope scope, string filter)
    {
        _baseDn = baseDn;
        _scope = scope;
        // Land in builder-canonical state: the preset filter
        // becomes builder rows when it projects cleanly, else the raw field carries it.
        var parse = LdapFilterConditions.Parse(filter);
        if (parse.Lossy)
        {
            _rawEdited = filter;
        }
        else
        {
            _conds = [.. parse.Conditions.Select(ConditionRow.From)];
            _join = parse.Join;
            _rawEdited = null;
        }
        return RunAsync();
    }

    private async Task OnFilterKeyDown(KeyboardEventArgs args)
    {
        // Enter runs the search: typing a filter and reaching for the mouse is the wrong
        // rhythm for the one control on this page you use every time.
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            await RunAsync();
        }
    }

    private Task RunAsync() => RunAsync(clearSelection: true, CancellationToken.None);

    private async Task RunAsync(bool clearSelection, CancellationToken cancellationToken)
    {
        if (clearSelection)
        {
            ClearSelection();
        }
        var filter = RawFilter;
        if (string.IsNullOrWhiteSpace(filter))
        {
            _error = "Enter a filter.";
            return;
        }

        var token = ++_runSeq;
        _running = true;
        _error = null;
        LdapSearchResult? result = null;
        string? error = null;
        try
        {
            result = await Directory.SearchAsync(new LdapSearchOptions
            {
                Filter = filter,
                BaseDn = string.IsNullOrWhiteSpace(_baseDn) ? null : _baseDn,
                Scope = _scope,
                Limit = _limit ?? Settings.DefaultSearchLimit,
            }, cancellationToken);
        }
        catch (DirectoryException ex)
        {
            error = $"The search failed ({ex.GetType().Name}): {ex.Message}";
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (token != _runSeq)
        {
            return;
        }

        _running = false;
        if (clearSelection)
        {
            // The previous result stays mounted while searching. Drop any selection made
            // against it before committing this replacement result.
            ClearSelection();
        }
        _error = error;
        _result = result;
        _ranFilter = filter;
        _commonSuffix = result is null ? string.Empty : DnDisplay.CommonSuffix([.. result.Entries.Select(static e => e.Dn)]);

        StateHasChanged();
    }

    private async Task CopyDnAsync(string dn) =>
        Toasts.Show(await Clipboard.CopyAsync(dn) ? "DN copied" : "copy failed — clipboard unavailable");

    private void SetSelection(SearchResultSelectionChange change)
    {
        if (change.Selected)
        {
            _selected[change.Entry.Dn] = change.Entry;
        }
        else
        {
            _selected.Remove(change.Entry.Dn);
        }
    }

    private void ClearSelection() => _selected.Clear();

    private void OpenBulkEdit()
    {
        if (_bulkEdit is not null || _selected.Count == 0)
        {
            return;
        }

        var entries = _selected.Values.ToImmutableArray();
        _bulkEdit = new BulkEditDialogModel
        {
            Entries = entries,
            AttributeCandidates = AttributeCandidates(entries),
            SearchGroupsAsync = SearchGroupsAsync,
            DescribeGroup = entry => GroupMembership.Detect(_schema, entry),
            ApplyAsync = ApplyBulkItemAsync,
            RunFinishedAsync = BulkRunFinishedAsync,
        };
    }

    private void CloseBulkEdit() => _bulkEdit = null;

    private Task<LdapSearchResult> SearchGroupsAsync(string query, CancellationToken cancellationToken) =>
        Directory.SearchAsync(new LdapSearchOptions
        {
            Filter = GroupMemberSearch.Filter(query),
            Limit = GroupMemberSearch.ResultLimit,
            Attributes = ["uid", "cn", "mail", "objectClass", "member", "uniqueMember", "memberUid"],
        }, cancellationToken);

    private Task<LdapOperationResult> ApplyBulkItemAsync(BulkEditPlanItem item) =>
        Directory.ModifyEntryAsync(item.TargetDn, [item.Change], CancellationToken.None);

    private async Task BulkRunFinishedAsync(BulkEditRunResult run)
    {
        using var refresh = new CancellationTokenSource();
        if (run.AllSucceeded)
        {
            ClearSelection();
        }
        else
        {
            RetainIncompleteSelection(_selected, run);
        }
        await RunAsync(clearSelection: false, refresh.Token);
        if (run.AllSucceeded)
        {
            Toasts.Show($"ldapmodify — {run.CompletedCount} selected entries updated");
        }
    }

    private IReadOnlyList<AttributeGuidance> AttributeCandidates(IEnumerable<LdapEntry> entries)
    {
        if (_schema is null)
        {
            return [];
        }

        var selected = entries.ToList();
        var classesByEntry = selected.Select(static entry => entry.Attributes
            .Where(static attribute => attribute.Name.Equals("objectClass", StringComparison.OrdinalIgnoreCase))
            .SelectMany(static attribute => attribute.Values));

        return FilterBulkCandidates(
            selected, SchemaGuide.SharedEditableCandidates(_schema, classesByEntry));
    }

    internal static IReadOnlyList<AttributeGuidance> FilterBulkCandidates(
        IEnumerable<LdapEntry> entries,
        IEnumerable<AttributeGuidance> candidates)
    {
        var selected = entries.ToList();
        var binaryAttributes = new HashSet<string>(
            selected.SelectMany(static entry => entry.Attributes)
                .Where(static attribute => attribute.IsBinary)
                .Select(static attribute => attribute.Name),
            StringComparer.OrdinalIgnoreCase);
        return [.. candidates.Where(candidate => !binaryAttributes.Contains(candidate.Name))];
    }

    /// <summary>Leaves only work that an incomplete bulk run did not already acknowledge.</summary>
    internal static void RetainIncompleteSelection(
        IDictionary<string, LdapEntry> selected, BulkEditRunResult run)
    {
        foreach (var outcome in run.Outcomes.Where(static outcome => outcome.Status == BulkEditItemStatus.Succeeded))
        {
            selected.Remove(outcome.Item.SelectedDn);
        }
    }

}
