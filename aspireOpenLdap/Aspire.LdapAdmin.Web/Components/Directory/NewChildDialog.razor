@*
    New child entry dialog on the owned ConsoleDialog frame. The parent DN renders in body
    markup with word-break, never in the title (docs/findings.md: a DN is one unbreakable
    token). Save semantics as AttributeDialog: inline error, close only on success.
*@

<ConsoleDialog Title="New child entry" OnCancel="Close">
    <ChildContent>
    <div class="dnline mono" style="margin-top: 0;">under @Model.ParentDn</div>
    <div class="field">
        <label>RDN <span class="mono text-muted">e.g. uid=jane.doe</span></label>
        <input class="input mono" @bind="Model.Rdn" @bind:event="oninput" spellcheck="false" />
    </div>
    @* The composed DN, live: a full DN pasted into the RDN box silently composes a child
       under a parent that does not exist, and the server's NoSuchObject reads as a mystery.
       Showing the composition as it is typed makes the mistake visible before submit. *@
    @if (Model.Rdn.Length > 0)
    {
        <div class="dnline mono" style="margin-top: 0;">
            @if (PreviewDn is { } preview)
            {
                <text>creates @preview</text>
            }
            else
            {
                <text>⚠ not a single attribute=value RDN — the parent is already fixed above</text>
            }
        </div>
    }
    <div class="field">
        <label>Object classes <span class="mono text-muted">comma-separated</span></label>
        <input class="input mono" @bind="Model.ObjectClasses" spellcheck="false"
               placeholder="inetOrgPerson, posixAccount" />
    </div>
    <div class="field">
        <label>Attributes <span class="mono text-muted">name: value, one per line</span></label>
        <textarea class="ta" style="min-height: 120px;" @bind="Model.AttributesText" spellcheck="false"
                  placeholder="cn: Jane Doe&#10;sn: Doe"></textarea>
    </div>
    @if (_error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@_error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Creating…" : "Create")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required ChildDialogModel Model { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? _error;
    private bool _busy;

    /// <summary>The DN the dialog would create, or null while the RDN is not one valid RDN.</summary>
    private string? PreviewDn
    {
        get
        {
            try
            {
                return LdifDotNet.Dn.Parse(Model.Rdn) is { Count: 1 }
                    ? LdifDotNet.Dn.Combine(Model.Rdn, Model.ParentDn)
                    : null;
            }
            catch (ArgumentException)
            {
                return null;
            }
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await Model.SaveAsync(Model);
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await Close();
        }
    }
}
