@*
    The owned modal frame: a native <dialog> shown with
    showModal(), wearing the .wide .blueprint panel and its four corner registration marks.
    The platform owns modality: top-layer rendering, background inertness (Tab can
    never reach the page behind, no matter what the dialog re-renders), Escape as a close
    request ("cancel" event), and the ::backdrop scrim. console.js relays close requests and
    backdrop clicks to CancelFromJs; .NET always decides whether the dialog actually closes.

    Structure rule: the panel must NOT be the scroll container. The
    corner marks sit 6px outside the frame by design, so a scrolling panel permanently
    "overflows" by 6px both axes and its auto scrollbars flip on every re-render — the
    per-keystroke scrollbar flicker. The UA gives dialog:modal overflow:auto, so console.css
    forces dialog.wide { overflow: visible }; only .dbody scrolls. The title and actions
    stay pinned on the frame.

    Never render the `open` attribute from Razor: showModal() owns it, and a Razor-rendered
    `open` would drop the dialog out of the top layer on the next diff.

    DNs never render in the title (one unbreakable token whose min-content width grows with
    tree depth); callers put them in body markup with word-break.
*@
@implements IAsyncDisposable
@inject IJSRuntime Js

<dialog class="wide blueprint" aria-label="@Title" tabindex="-1"
        data-busy="@(Busy ? "true" : "false")" @ref="_panel">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    <div class="dialog-title">@Title</div>
    <div class="dbody">@ChildContent</div>
    <div class="dialog-actions">@Actions</div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Raised for every close request; the owner closes or requests cancellation.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// True while the owner's operation is in flight. The owner ignores close attempts for
    /// single writes and may request stopping between requests for batch operations.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    private ElementReference _panel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ConsoleDialog>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/console.js");
            await _module.InvokeVoidAsync("openModal", _panel, _self);
        }
    }

    /// <summary>Called by console.js for a close request (Escape) or a backdrop click.</summary>
    [JSInvokable]
    public Task CancelFromJs() => OnCancel.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                // closeModal works from module state, not the element reference: on the
                // Blazor unmount path the render batch has already removed the element
                // before this interop call runs, and native focus restore never fires.
                await _module.InvokeVoidAsync("closeModal");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone; nothing to release.
            }
        }
        _self?.Dispose();
    }
}
