@*
    Delete confirmation on the owned ConsoleDialog frame. The DN renders in body markup with
    word-break, never in the title (docs/findings.md). Save protocol from DialogBase.
*@
@inherits DialogBase

<ConsoleDialog Title="Delete entry" OnCancel="CloseAsync" Busy="Busy">
    <ChildContent>
    <div class="dnline mono" style="margin-top: 0;">@Model.Dn</div>
    <p class="note">
        The entry is removed from the directory. Entries with children cannot be deleted —
        the server refuses non-leaf deletes — unless the subtree option is checked.
    </p>
    <label class="check">
        <input type="checkbox" @bind="Model.Subtree" disabled="@Busy" />
        Also delete every entry beneath this one (subtree)
    </label>
    @if (Model.Subtree)
    {
        <p class="text-muted note">
            Deletes depth-first, children before parents, and stops at the first refusal
            naming the entry that failed. The server has no tree-delete control, so this is
            one delete per entry.
        </p>
    }
    @if (Error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@Error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" disabled="@Busy" @onclick="CloseAsync">Cancel</button>
        <button class="btn btn-primary" disabled="@Busy"
                @onclick="@(() => SaveAsync(() => Model.SaveAsync(Model)))">@(Busy ? "Deleting…" : "Delete")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required DeleteDialogModel Model { get; set; }
}
