@inherits DialogBase

<ConsoleDialog Title="Reset password" OnCancel="CancelAsync" Busy="Busy">
    <ChildContent>
    <div class="dnline mono" style="margin-top: 0;">@Model.Dn</div>
    <div class="field">
        <label for="new-password">New password</label>
        <input id="new-password" class="input mono" type="password" autocomplete="new-password"
               @bind="_password" disabled="@Busy" />
    </div>
    <div class="field">
        <label for="confirm-password">Confirm password</label>
        <input id="confirm-password" class="input mono" type="password" autocomplete="new-password"
               @bind="_confirmation" disabled="@Busy" />
    </div>
    @if (Error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@Error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" @onclick="CancelAsync">@(CancellationRequested ? "Cancelling" : "Cancel")</button>
        <button class="btn btn-primary" disabled="@Busy" @onclick="SubmitAsync">@(Busy ? "Resetting…" : "Reset password")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required PasswordDialogModel Model { get; set; }

    private string _password = string.Empty;
    private string _confirmation = string.Empty;

    private Task SubmitAsync()
    {
        if (_password.Length == 0)
        {
            Error = "Enter a password.";
            return Task.CompletedTask;
        }
        if (!string.Equals(_password, _confirmation, StringComparison.Ordinal))
        {
            Error = "Passwords do not match.";
            return Task.CompletedTask;
        }

        return SaveAsync(token => Model.SaveAsync(_password, token));
    }
}
