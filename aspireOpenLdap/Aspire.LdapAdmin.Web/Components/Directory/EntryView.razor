@*
    Attribute grid for one entry.

    Representation comes from the service's IsBinary flag and is never re-derived here: the
    service decides it from the schema's declared syntax, the RFC 4522 ;binary transfer
    option, or — last — the bytes, and says which (Classification). When IsBinary is true
    every value is base64, so it is labelled and sized rather than printed as text.

    MultiLine, and no Virtualize/ItemSize: an attribute renders one row with every value
    stacked in the cell, so rows must size to their content. FluentDataGrid writes fixed row
    tracks otherwise and slices the second value through the middle (docs/findings.md).
*@

<FluentStack Orientation="@Orientation.Horizontal" HorizontalGap="8"
             VerticalAlignment="@VerticalAlignment.Center">
    <FluentLabel Typo="@Typography.H4" Style="word-break: break-all;">@Entry.Dn</FluentLabel>
    <FluentButton Appearance="@Appearance.Stealth" Title="Copy DN to clipboard"
                  IconStart="@(new Icons.Regular.Size16.Copy())" OnClick="CopyDnAsync" />
</FluentStack>

<FluentDataGrid Items="@Rows" TGridItem="LdapAttributeValues" GridTemplateColumns="1fr 2fr"
                MultiLine="true" ResizableColumns="true">
    <TemplateColumn Title="Attribute" Sortable="false">
        <FluentStack Orientation="@Orientation.Horizontal" HorizontalGap="6"
                     VerticalAlignment="@VerticalAlignment.Center" Wrap="true">
            <strong>@context.Name</strong>
            @if (context.IsBinary)
            {
                <FluentBadge Appearance="@Appearance.Neutral" title="@ClassificationTitle(context.Classification)">binary</FluentBadge>
            }
            @if (context.Values.Count > 1)
            {
                @* Paired with the display cap (#98): while capped the badge itself says
                   "N of M values", so the cap is surfaced next to the attribute name too. *@
                <FluentBadge Appearance="@Appearance.Neutral">@CountBadge(PlanFor(context))</FluentBadge>
            }
            @if (OnEdit.HasDelegate)
            {
                <FluentButton Appearance="@Appearance.Stealth" Title="@($"Edit {context.Name}")"
                              IconStart="@(new Icons.Regular.Size16.Edit())"
                              OnClick="@(() => OnEdit.InvokeAsync(context))" />
            }
        </FluentStack>
    </TemplateColumn>
    <TemplateColumn Title="Value" Sortable="false">
        @if (context.Values.Count == 0)
        {
            <em>(no values)</em>
        }
        else
        {
            @* Display cap (#98, absorbed #100): a many-valued attribute renders at most the
               AppHost-set cap of values, and the cap is always surfaced, never silent —
               "N of M values" plus an explicit expand, paired with the count badge above. *@
            var plan = PlanFor(context);
            @foreach (var value in context.Values.Take(plan.Shown))
            {
                <div style="overflow-wrap: anywhere;">
                    @if (context.IsBinary)
                    {
                        <em>@DescribeBinary(value)</em>
                        <details>
                            <summary>base64</summary>
                            <code>@value</code>
                        </details>
                    }
                    else
                    {
                        @value
                    }
                </div>
            }
            @if (plan.Capped)
            {
                <div>
                    <FluentButton Appearance="@Appearance.Lightweight"
                                  OnClick="@(() => { _expanded.Add(context.Name); })">
                        Showing @plan.Shown of @plan.Total values — show all
                    </FluentButton>
                </div>
            }
            else if (context.Values.Count > Cap)
            {
                <div>
                    <FluentButton Appearance="@Appearance.Lightweight"
                                  OnClick="@(() => { _expanded.Remove(context.Name); })">
                        Show first @Cap of @plan.Total values
                    </FluentButton>
                </div>
            }
        }
    </TemplateColumn>
</FluentDataGrid>

@code {
    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    [Inject]
    private IToastService Toasts { get; set; } = default!;

    [Inject]
    private LdapAdminSettings Settings { get; set; } = default!;

    [Parameter, EditorRequired]
    public required LdapEntry Entry { get; set; }

    /// <summary>Raised with the attribute the user asked to edit; absent = read-only view.</summary>
    [Parameter]
    public EventCallback<LdapAttributeValues> OnEdit { get; set; }

    private IQueryable<LdapAttributeValues> Rows =>
        Entry.Attributes.OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase).AsQueryable();

    /// <summary>Attribute names the user explicitly expanded past the display cap.</summary>
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    private string? _entryDn;

    private int Cap => Settings.AttributeValueDisplayCap;

    private ValueDisplayPlan PlanFor(LdapAttributeValues attribute) =>
        PlanValues(attribute.Values.Count, Cap, _expanded.Contains(attribute.Name));

    /// <summary>
    /// Expansion is per attribute of the entry on screen; showing a different entry resets
    /// it, so one entry's "show all" can never silently uncap another's.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!string.Equals(_entryDn, Entry.Dn, StringComparison.Ordinal))
        {
            _entryDn = Entry.Dn;
            _expanded.Clear();
        }
    }

    /// <summary>How many of an attribute's values render, and whether the cap cut any off.</summary>
    internal readonly record struct ValueDisplayPlan(int Shown, int Total, bool Capped);

    /// <summary>
    /// The cap decision (#98): an expanded attribute — or one at/below the cap — shows every
    /// value; anything else shows exactly the cap and says so. Never silent: Capped is true
    /// whenever fewer than every value renders.
    /// </summary>
    internal static ValueDisplayPlan PlanValues(int total, int cap, bool expanded) =>
        expanded || total <= cap
            ? new ValueDisplayPlan(total, total, Capped: false)
            : new ValueDisplayPlan(cap, total, Capped: true);

    /// <summary>The count badge's text — it states the cap while one is in effect.</summary>
    internal static string CountBadge(ValueDisplayPlan plan) =>
        plan.Capped ? $"{plan.Shown} of {plan.Total} values" : $"{plan.Total} values";

    private async Task CopyDnAsync()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", Entry.Dn);
        Toasts.ShowSuccess("DN copied");
    }

    /// <summary>Why this attribute is shown as binary — the classification travels with the value.</summary>
    private static string ClassificationTitle(LdapValueClassification classification) => classification switch
    {
        LdapValueClassification.Schema => "Binary per the server schema's declared syntax; transported as base64",
        LdapValueClassification.TransferOption => "Binary per the RFC 4522 ;binary transfer option; transported as base64",
        _ => "Binary because a value is not valid UTF-8 (schema unavailable or silent); transported as base64",
    };

    /// <summary>
    /// Decoded size of a base64 value, computed from its length rather than by decoding, so
    /// a large certificate or photo is not materialised just to label it.
    /// </summary>
    internal static string DescribeBinary(string base64)
    {
        var padding = base64.EndsWith("==", StringComparison.Ordinal) ? 2
            : base64.EndsWith('=') ? 1
            : 0;
        var bytes = Math.Max((base64.Length / 4 * 3) - padding, 0);
        return bytes == 1 ? "1 byte" : $"{bytes:N0} bytes";
    }
}
