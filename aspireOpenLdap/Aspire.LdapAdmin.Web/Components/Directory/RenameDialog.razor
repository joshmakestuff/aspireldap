@*
    Rename/move dialog on the owned ConsoleDialog frame. The DN renders in body markup with
    word-break, never in the title (docs/findings.md). Save semantics as AttributeDialog.
*@

<ConsoleDialog Title="Rename entry" OnCancel="Close">
    <ChildContent>
    <div class="dnline mono" style="margin-top: 0;">@Model.Dn</div>
    <div class="field">
        <label>New RDN <span class="mono text-muted">e.g. uid=jane.doe</span></label>
        <input class="input mono" @bind="Model.NewRdn" spellcheck="false" />
    </div>
    <div class="field">
        <label>New parent DN <span class="text-muted">(leave empty to rename in place)</span></label>
        <input class="input mono" @bind="Model.NewParentDn" spellcheck="false" />
    </div>
    <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer;">
        <input type="checkbox" @bind="Model.DeleteOldRdn" />
        Remove the old RDN attribute value
    </label>
    @if (_error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@_error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Renaming…" : "Rename")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required RenameDialogModel Model { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? _error;
    private bool _busy;

    private Task Close() => OnClose.InvokeAsync();

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await Model.SaveAsync(Model);
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await Close();
        }
    }
}
