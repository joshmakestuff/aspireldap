@*
    Add/edit attribute dialog on the owned ConsoleDialog frame, schema-aware: the
    add path offers a filtered picker over the MUST/MAY set of the entry's object classes,
    and the value input adapts to the chosen type (SINGLE-VALUE gets one field). The schema
    is guidance, not enforcement — free-typed names still go to the server, which stays
    authoritative; a null Schema (unavailable subschema) degrades to the free-text form.

    Save protocol from DialogBase: a returned error renders inline and the dialog closes
    only on null (success), so a failed write never dismisses the user's input.
*@
@inherits DialogBase

<ConsoleDialog Title="@(Model.IsNew ? "Add attribute" : $"Edit {Model.Name}")" OnCancel="CancelAsync" Busy="Busy">
    <ChildContent>
    @if (Model.IsNew)
    {
        <div class="field">
            <label>Attribute name</label>
            @if (Schema is not null)
            {
                <AttributePicker Candidates="_candidates" @bind-Value="Model.Name"
                                 Placeholder="attributeType" Disabled="Busy" />
            }
            else
            {
                <input class="input mono" @bind="Model.Name" spellcheck="false" disabled="@Busy" />
            }
        </div>
    }
    @if (Guidance is { } guidance)
    {
        <div class="hint mono">
            @guidance.SyntaxLabel · @(guidance.SingleValued ? "single-valued" : "multi-valued")@(guidance.Required ? " · required by the object classes" : "")
        </div>
        @if (guidance.NoUserModification)
        {
            <div class="bar err" role="alert" style="margin-bottom: 0;">
                @guidance.Name is NO-USER-MODIFICATION — the server maintains it and will refuse this write.
            </div>
        }
    }
    else if (Schema is not null && Model.Name.Length > 0)
    {
        <div class="hint">Not in the schema for this entry's object classes — the server decides.</div>
    }
    @for (var i = 0; i < Model.Values.Count; i++)
    {
        var index = i;
        <div class="field">
            <label for="attribute-value-@index">Value @(index + 1)@(Model.IsBinary ? " (base64)" : "")</label>
            <textarea id="attribute-value-@index" class="ta ta-sm"
                      @bind:get="Model.Values[index]" @bind:set="value => SetValue(index, value)"
                      spellcheck="false" disabled="@Busy"></textarea>
            <button class="btn btn-ghost" disabled="@Busy"
                    @onclick="@(() => Model.Values = [.. Model.Values.Where((_, position) => position != index)])">Remove value</button>
        </div>
    }
    <button class="btn btn-ghost" disabled="@(Busy || (Guidance is { SingleValued: true } && Model.Values.Count > 0))"
            @onclick="@(() => Model.Values = [.. Model.Values, string.Empty])">Add value</button>
    <p class="text-muted note">
        Each field is one value and may contain multiple lines. A blank field is an empty value;
        use Remove value to remove it.
    </p>
    @if (!Model.IsNew)
    {
        <p class="text-muted note">
            Saving replaces every value of this attribute; removing all value fields removes it.
        </p>
    }
    @if (Error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@Error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" disabled="@Busy" @onclick="CancelAsync">Cancel</button>
        <button class="btn btn-primary" disabled="@Busy"
                @onclick="@(() => SaveAsync(token => Model.SaveAsync(Model, token)))">@(Busy ? "Saving…" : "Save")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required AttributeDialogModel Model { get; set; }

    /// <summary>The loaded subschema, or null when unavailable (free-text fallback).</summary>
    [Parameter]
    public LdifDotNet.Schema.LdapSchema? Schema { get; set; }

    [Parameter]
    public IReadOnlySet<string> ExcludedAttributes { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<AttributeGuidance> _candidates = [];

    private IEnumerable<string> EntryObjectClasses =>
        Model.Entry.Attributes.FirstOrDefault(static a =>
            a.Name.Equals("objectClass", StringComparison.OrdinalIgnoreCase))?.Values ?? [];

    private AttributeGuidance? Guidance =>
        Schema is null || Model.Name.Length == 0
            ? null
            : SchemaGuide.Describe(Schema, Model.Name,
                _candidates.FirstOrDefault(c => c.Name.Equals(Model.Name, StringComparison.OrdinalIgnoreCase))?.Required ?? false);

    private void SetValue(int index, string? value)
    {
        var values = Model.Values.ToArray();
        values[index] = value ?? string.Empty;
        Model.Values = values;
    }

    protected override void OnParametersSet()
    {
        _candidates = Schema is null
            ? []
            : [.. SchemaGuide.AddCandidates(Schema, EntryObjectClasses, Model.Entry.Attributes.Select(static a => a.Name))
                .Where(candidate => !ExcludedAttributes.Contains(candidate.Name))];
    }
}
