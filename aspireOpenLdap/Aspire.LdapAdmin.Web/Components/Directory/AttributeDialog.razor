@*
    Add/edit attribute dialog body, hosted by FluentDialogProvider via IDialogService.

    All four entry dialogs are provider-hosted rather than inline <FluentDialog> markup:
    inline, the FAST dialog's .control keeps its stylesheet default height (480px fixed,
    no overflow handling), so form content taller than that renders past the dialog
    background — the #104 defect class. The provider path sizes the panel from
    DialogParameters and gives the body its own scroll region, so fields stay inside the
    dialog bounds whatever the content height.
*@
@implements IDialogContentComponent<AttributeDialogModel>

<FluentDialogBody>
    <FluentStack Orientation="@Orientation.Vertical" VerticalGap="12">
        @if (Content.IsNew)
        {
            <FluentTextField @bind-Value="Content.Name" Label="Attribute name"
                             Spellcheck="false" Style="width: 100%;" />
        }
        <FluentTextArea @bind-Value="Content.ValuesText" Rows="6" Style="width: 100%;"
                        Label="@(Content.IsBinary ? "Values (base64, one per line)" : "Values (one per line)")"
                        Spellcheck="false" />
        @if (!Content.IsNew)
        {
            <FluentLabel Typo="@Typography.Body">
                Saving replaces every value of this attribute; saving with no values removes it.
            </FluentLabel>
        }
        @if (_error is not null)
        {
            <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_error</FluentMessageBar>
        }
    </FluentStack>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="@Appearance.Accent" Loading="_busy" OnClick="SaveAsync">Save</FluentButton>
    <FluentButton OnClick="@(() => Dialog.CancelAsync())">Cancel</FluentButton>
</FluentDialogFooter>

@code {
    [Parameter]
    public AttributeDialogModel Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private string? _error;
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await Content.SaveAsync(Content);
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await Dialog.CloseAsync(Content);
        }
    }
}
