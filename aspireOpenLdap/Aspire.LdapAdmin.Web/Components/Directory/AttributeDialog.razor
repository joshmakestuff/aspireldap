@*
    Add/edit attribute dialog on the owned ConsoleDialog frame. The model carries the save
    delegate the shell provides: a returned error renders inline and the dialog closes only
    on null (success), so a failed write never dismisses the user's input.
*@

<ConsoleDialog Title="@(Model.IsNew ? "Add attribute" : $"Edit {Model.Name}")" OnCancel="Close">
    <ChildContent>
    @if (Model.IsNew)
    {
        <div class="field">
            <label>Attribute name</label>
            <input class="input mono" @bind="Model.Name" spellcheck="false" />
        </div>
    }
    <div class="field">
        <label>@(Model.IsBinary ? "Values (base64, one per line)" : "Values (one per line)")</label>
        <textarea class="ta" style="min-height: 120px;" @bind="Model.ValuesText" spellcheck="false"></textarea>
    </div>
    @if (!Model.IsNew)
    {
        <p class="text-muted" style="font-size: 13px; margin: 0;">
            Saving replaces every value of this attribute; saving with no values removes it.
        </p>
    }
    @if (_error is not null)
    {
        <div class="bar err" role="alert" style="margin-bottom: 0;">@_error</div>
    }
    </ChildContent>
    <Actions>
        <button class="btn btn-secondary" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save")</button>
    </Actions>
</ConsoleDialog>

@code {
    [Parameter, EditorRequired]
    public required AttributeDialogModel Model { get; set; }

    /// <summary>Raised when the dialog is done (saved or cancelled); the shell removes it.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? _error;
    private bool _busy;

    private Task Close() => OnClose.InvokeAsync();

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await Model.SaveAsync(Model);
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await Close();
        }
    }
}
