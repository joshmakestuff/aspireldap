<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Aspire -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.0" />
  </ItemGroup>

  <!-- OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
  </ItemGroup>

  <!-- LDIF (RFC 2849) reading/writing + fake directory data generation -->
  <ItemGroup>
    <PackageVersion Include="LdifDotNet" Version="0.8.0" />
    <PackageVersion Include="LdifDotNet.Generator" Version="0.8.0" />
    <PackageVersion Include="LdifDotNet.Schema" Version="0.8.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions / runtime — keep on the current net10 servicing release -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.11" />
  </ItemGroup>

  <!-- Build / packaging -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.176" />
  </ItemGroup>

  <!-- Test -->
  <ItemGroup>
    <!-- Direct reference only to lift bunit's transitive AngleSharp above the advisory
         GHSA-pgww-w46g-26qg range. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="bunit" Version="1.40.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
