<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test AppHost for the admin: an OpenLDAP resource plus the admin web host, used by
    Aspire.LdapAdmin.Tests. Not a sample and not a package product.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <ProjectReference Include="..\Aspire.Hosting.OpenLdap\Aspire.Hosting.OpenLdap.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Aspire.OpenLdap.Testing\Aspire.OpenLdap.Testing.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
