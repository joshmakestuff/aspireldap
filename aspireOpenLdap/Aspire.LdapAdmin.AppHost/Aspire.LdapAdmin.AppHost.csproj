<Project Sdk="Aspire.AppHost.Sdk">

  <!--
    Test AppHost for the admin: an OpenLDAP resource plus the admin web host, used by
    Aspire.LdapAdmin.Tests. Not a sample and not a package product.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" VersionOverride="10.0.11" />
    <ProjectReference Include="..\Aspire.Hosting.OpenLdap\Aspire.Hosting.OpenLdap.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Aspire.LdapAdmin.Web\Aspire.LdapAdmin.Web.csproj" />
  </ItemGroup>

</Project>
