<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Switches the linked Shared\OpenLdapNativeLibraryResolver.cs to this assembly's namespace. -->
    <DefineConstants>$(DefineConstants);ASPIRE_HOSTING_OPENLDAP</DefineConstants>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>JoshMakeStuff.Aspire.Hosting.OpenLdap</PackageId>
    <Description>.NET Aspire hosting integration for OpenLDAP. Adds an OpenLDAP container resource (with optional TLS, health checks, and phpLDAPadmin sidecar) to your AppHost.</Description>
    <PackageTags>aspire;hosting;openldap;ldap;directory</PackageTags>
    <!-- The assemblies are MIT, but the bundled docker build context (contentFiles/…/openldap/)
         is Apache-2.0 (derived from Bitnami OpenLDAP) — see THIRD-PARTY-NOTICES.txt. -->
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
    <!-- Agent-facing API reference: nupkg root for humans/agents grepping the package cache,
         and skills/SKILL.md per the emerging nuget-skills convention. -->
    <None Include="..\AGENTS.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\AGENTS.md" Pack="true" PackagePath="skills\SKILL.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\OpenLdapNativeLibraryResolver.cs" Link="OpenLdapNativeLibraryResolver.cs" />
    <Compile Include="..\Shared\ConnectionStringQuoting.cs" Link="ConnectionStringQuoting.cs" />
    <Compile Include="..\Shared\OpenLdapCertificateValidation.cs" Link="OpenLdapCertificateValidation.cs" />
    <Compile Include="..\Shared\OpenLdapUnixTlsTrust.cs" Link="OpenLdapUnixTlsTrust.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.OpenLdap.Tests" />
  </ItemGroup>

  <!--
    Bundle the OpenLDAP docker build context (Dockerfile + rootfs scripts) so the
    integration works for NuGet consumers without requiring them to clone this repo.
    Files are copied to the consumer's build output and packed into contentFiles/ of
    the nupkg with copyToOutput=true so a PackageReference produces the same layout.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\openldap\2.6\debian-13\**\*" Link="openldap\2.6\debian-13\%(RecursiveDir)%(Filename)%(Extension)" Pack="true" PackagePath="contentFiles/any/any/openldap/2.6/debian-13/" PackageCopyToOutput="true" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Bundle the LdapAdmin container build context (#78): the Dockerfile plus the published
    Aspire.LdapAdmin.Web output, packed into contentFiles/any/any/ldapadmin/ so a
    PackageReference lands the whole context in the consumer's build output — mirroring the
    OpenLDAP context above. Unlike the OpenLDAP context this is pack-time-only (no
    CopyToOutputDirectory): project-referenced dev AppHosts run the admin via AddProject, and
    WithLdapAdmin() fails with an actionable error when the payload is absent.
  -->
  <PropertyGroup>
    <LdapAdminPayloadDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'ldapadmin-payload'))</LdapAdminPayloadDir>
    <!-- NU5100: the published admin app's assemblies live under contentFiles/ deliberately —
         they are container-image cargo, not references for the consuming project.
         NU5123: the Fluent UI static web assets in the same payload (#83) sit under
         _content/Microsoft.FluentUI.AspNetCore.Components/..., which NuGet flags as
         potentially too long to extract on a long-path-disabled Windows host. The paths are
         fixed by the library, not by us, and the clean-consumer pack test is the decisive
         check that the payload actually extracts and serves. -->
    <NoWarn>$(NoWarn);NU5100;NU5123</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\ldapadmin\Dockerfile" Pack="true" PackagePath="contentFiles/any/any/ldapadmin" PackageCopyToOutput="true" Visible="false" />
  </ItemGroup>

  <!--
    Publishes the admin web host into the pack payload immediately before NuGet collects package
    files. Deliberately an MSBuild-task publish rather than a ProjectReference: the dependency
    direction stays one-way (no public assembly depends on admin assemblies) and the payload is
    runtime cargo, not a compile-time dependency. Global properties (Version,
    ContinuousIntegrationBuild, ...) flow into the publish, so the payload is stamped identically
    to the hosting assemblies in the same pack.
  -->
  <Target Name="PublishLdapAdminPayload" BeforeTargets="_GetPackageFiles">
    <!-- Publish never deletes stale files from a previous PublishDir; start clean so the
         payload is exactly this publish. -->
    <RemoveDir Directories="$(LdapAdminPayloadDir)" />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Aspire.LdapAdmin.Web\Aspire.LdapAdmin.Web.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);PublishDir=$(LdapAdminPayloadDir)app\;SelfContained=false;UseAppHost=false" />
    <ItemGroup>
      <!-- NuGet appends each wildcard-matched file's recursive subpath to PackagePath itself,
           preserving the publish layout under ldapadmin/app/. -->
      <_LdapAdminPayloadFile Include="$(LdapAdminPayloadDir)app\**\*" />
      <Content Include="@(_LdapAdminPayloadFile)" Pack="true" PackagePath="contentFiles/any/any/ldapadmin/app/" PackageCopyToOutput="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="LdifDotNet" />
    <PackageReference Include="LdifDotNet.Generator" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

</Project>
